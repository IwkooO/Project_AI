#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=test
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=01:00:00
#SBATCH --output=jobs/outputs/test/savee_me.log

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/Project_AI/

source activate streetview

export PYTHONPATH=$PYTHONPATH:.
python scripts/evaluation/eval_best_checkpoint.py