#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=stage2_geo
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=24:00:00
#SBATCH --output=jobs/outputs/stage2_geo_concept_only%j.out

# Note: this env has activate.d scripts that reference optional env vars.
# Using `set -u` (nounset) can crash `source activate` on unset vars (e.g. GEOTIFF_CSV).
set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"

# Activate environment
export GEOTIFF_CSV="${GEOTIFF_CSV:-}"
set +u
source activate streetview
set -u

wandb_api_key="9073a011764cb23fce5384443a3996ca9c5d9198"
export WANDB_API_KEY="$wandb_api_key"

# Paths
SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
TRAIN_CSV="${SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${SPLITS_DIR}/dataset_val.csv"
TEST_CSV="${SPLITS_DIR}/dataset_test.csv"

# Cached embeddings (must already exist)
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"

# Concept vocab/priors
CONCEPT_DATA="${CONCEPT_DATA:-data/concept_data_v2}"

# Phase1 checkpoint (must be from query_topk_256 training)
# Best performing: DIV=1.0 with test Acc@1=0.3991
# Can be overridden via environment variable
PHASE1_CHECKPOINT="${PHASE1_CHECKPOINT:-/home/igodzwon/Project_AI/checkpoints/reruns/rerun_20251225_184801/SIMPLE_DIM256/PHASE1_SIMPLE_DIM256_TAU0.25_K6_STK0.40_LK5_DIV1.0/phase1/best_phase1.pt}"

# Phase1 config (must match checkpoint)
PHASE1_TAU="${PHASE1_TAU:-0.25}"
PHASE1_TOPK="${PHASE1_TOPK:-6}"
PHASE1_STK="${PHASE1_STK:-0.40}"
PHASE1_LK="${PHASE1_LK:-5}"
PHASE1_DIV="${PHASE1_DIV:-1.0}"
PHASE1_PROJ_TYPE="${PHASE1_PROJ_TYPE:-simple}"

# Stage2 mode: 'both', 'concept_only', or 'image_only'
# Can be overridden via environment variable
STAGE2_MODE="${STAGE2_MODE:-concept_only}"

# Output directory for Stage 2 run (includes mode and phase1 config)
OUTPUT_DIR="${OUTPUT_DIR:-checkpoints/stage2_${PHASE1_PROJ_TYPE}_tau${PHASE1_TAU}_k${PHASE1_TOPK}_stk${PHASE1_STK}_lk${PHASE1_LK}_div${PHASE1_DIV}_${STAGE2_MODE}}"

# WandB run name (can be overridden via environment variable)
WANDB_RUN_NAME="${WANDB_RUN_NAME:-stage2_${PHASE1_PROJ_TYPE}_tau${PHASE1_TAU}_k${PHASE1_TOPK}_stk${PHASE1_STK}_lk${PHASE1_LK}_div${PHASE1_DIV}_${STAGE2_MODE}}"

mkdir -p jobs/outputs
mkdir -p "$OUTPUT_DIR"

# --------------------------------------------------------------------------------------
# IMPORTANT: Avoid race conditions / split drift during long Stage2 runs.
# Copy split CSVs into a per-run working directory so training/eval is consistent even if
# some other job regenerates or rewrites the shared splits.
# --------------------------------------------------------------------------------------
RUN_ID="${SLURM_JOB_ID:-local_$(date +%Y%m%d_%H%M%S)}"
RUN_WORKDIR="${OUTPUT_DIR}/run_${RUN_ID}"
RUN_SPLITS_DIR="${RUN_WORKDIR}/splits"
mkdir -p "$RUN_SPLITS_DIR"

for split in train val test; do
  src="${SPLITS_DIR}/dataset_${split}.csv"
  if [[ -f "${src}.bak" ]]; then
    cp "${src}.bak" "${RUN_SPLITS_DIR}/dataset_${split}.csv"
  else
    cp "${src}" "${RUN_SPLITS_DIR}/dataset_${split}.csv"
  fi
done

SPLITS_DIR="$RUN_SPLITS_DIR"
TRAIN_CSV="${SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${SPLITS_DIR}/dataset_val.csv"
TEST_CSV="${SPLITS_DIR}/dataset_test.csv"

echo "============================================================"
echo "Stage 2 Geolocation Training"
echo "============================================================"
echo "Phase1 checkpoint: $PHASE1_CHECKPOINT"
echo "Cached embeddings: $CACHED_DIR"
echo "Output directory: $OUTPUT_DIR"
echo "WandB run name: $WANDB_RUN_NAME"
echo "============================================================"

# Verify Phase1 checkpoint exists
if [[ ! -f "$PHASE1_CHECKPOINT" ]]; then
  echo "ERROR: Phase1 checkpoint not found: $PHASE1_CHECKPOINT"
  echo "Please train Phase1 first using scripts/training/train_cbm.py"
  exit 1
fi

# Verify cached embeddings exist
if [[ ! -f "$CACHED_DIR/train_pooled_embeddings.pt" || ! -f "$CACHED_DIR/train_metadata.json" ]]; then
  echo "ERROR: Missing cached embeddings in $CACHED_DIR"
  echo "Run precompute_streetclip_embeddings.py first."
  exit 1
fi

# Verify test CSV exists (optional but recommended)
if [[ ! -f "$TEST_CSV" ]]; then
  echo "WARNING: Test CSV not found: $TEST_CSV"
  echo "Test set evaluation will be skipped."
  TEST_CSV=""
fi

# Auto-detect mode if not explicitly set
if [[ -z "$STAGE2_MODE" ]]; then
  # Check if patch tokens exist (required for mode='both' or 'image_only')
  if [[ ! -f "$CACHED_DIR/train_patch_tokens.pt" ]]; then
    echo "WARNING: Patch tokens not found. Stage2 mode will be set to 'concept_only'"
    STAGE2_MODE="concept_only"
  else
    STAGE2_MODE="concept_only"
  fi
fi

# Verify mode is valid and compatible with available data
if [[ "$STAGE2_MODE" == "both" || "$STAGE2_MODE" == "image_only" ]]; then
  if [[ ! -f "$CACHED_DIR/train_patch_tokens.pt" ]]; then
    echo "ERROR: Mode '$STAGE2_MODE' requires patch tokens, but they are not found."
    echo "Please set STAGE2_MODE='concept_only' or ensure patch tokens are cached."
    exit 1
  fi
fi

echo "============================================================"
echo "Training Stage 2 Geolocation Model"
echo "  - Mode: $STAGE2_MODE"
echo "  - WandB run name: $WANDB_RUN_NAME"
echo "  - Num cells: 1000"
echo "  - Hidden dim: 512"
echo "  - Cross-attention layers: 2"
echo "  - Offset loss weight: 50.0 (to balance with cell loss)"
if [[ -n "$TEST_CSV" ]]; then
  echo "  - Test evaluation: Enabled"
else
  echo "  - Test evaluation: Disabled (no test CSV)"
fi
echo "============================================================"

python -m cbm.phase2.train \
  --train-csv "$TRAIN_CSV" \
  --val-csv "$VAL_CSV" \
  ${TEST_CSV:+--test-csv "$TEST_CSV"} \
  --cached-dir "$CACHED_DIR" \
  --phase1-checkpoint "$PHASE1_CHECKPOINT" \
  --concept-data-dir "$CONCEPT_DATA" \
  --output-dir "$OUTPUT_DIR" \
  --num-cells 1000 \
  --hidden-dim 512 \
  --num-heads 8 \
  --num-layers 2 \
  --dropout 0.1 \
  --mode "$STAGE2_MODE" \
  --batch-size 64 \
  --epochs 100 \
  --lr 1e-4 \
  --weight-decay 0.01 \
  --cell-loss-weight 1.0 \
  --offset-loss-weight 6371.0 \
  --concept-dim 256 \
  --patch-dim 1024 \
  --phase1-dropout 0.3 \
  --phase1-mil-topk "$PHASE1_TOPK" \
  --phase1-mil-tau "$PHASE1_TAU" \
  --phase1-mix-depth 1 \
  --phase1-mix-heads 4 \
  --phase1-mix-mlp-ratio 2.0 \
  --phase1-mix-local-kernel-size "$PHASE1_LK" \
  --text-model-name "geolocal/StreetCLIP" \
  --concept-prompt-template "a street view photo containing {}" \
  --wandb \
  --wandb-project "cbm_stage2" \
  --wandb-run-name "$WANDB_RUN_NAME" \
  --early-stop-patience 10

echo "============================================================"
echo "Stage 2 training complete!"
echo "Outputs: $OUTPUT_DIR/phase2/"
echo "  - Checkpoints: $OUTPUT_DIR/phase2/best_phase2.pt"
echo "  - Visualizations: $OUTPUT_DIR/phase2/visualizations/"
if [[ -n "$TEST_CSV" ]]; then
  echo "  - Test results: $OUTPUT_DIR/phase2/test_results.json"
  echo "  - Test visualizations: $OUTPUT_DIR/phase2/visualizations/test_set/"
fi
echo "============================================================"

# Cleanup: Remove temporary CSV files to save disk space (they don't change)
echo "Cleaning up temporary CSV files..."
if [[ -d "$RUN_SPLITS_DIR" ]]; then
  rm -f "${RUN_SPLITS_DIR}"/*.csv
  echo "Removed CSV files from: $RUN_SPLITS_DIR"
fi
echo "Cleanup complete!"
