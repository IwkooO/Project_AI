#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=llm_concept_refinement
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=24:00:00
#SBATCH --mem=16GB
#SBATCH --output=jobs/outputs/llm_concept_refinement_%j.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/Project_AI/
source activate streetview

# Install agno if needed
pip install agno --quiet
pip install openai --quiet

mkdir -p jobs/outputs

echo "========================================================================"
echo "LLM Concept Refinement Job"
echo "========================================================================"
echo "Job started at: $(date)"
echo "Mapping meta_name + note pairs to predefined concept list"
echo "Checkpoints saved every 1000 items"
echo "========================================================================"

python -u scripts/data_processing/llm_concept_refinement.py

echo "========================================================================"
echo "Job finished at: $(date)"
echo "========================================================================"

