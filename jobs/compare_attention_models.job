#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=compare_attn
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=2:00:00
#SBATCH --output=jobs/outputs/compare_attention_models_%j.out

set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"
mkdir -p jobs/outputs

echo "============================================================"
echo "Activating environment"
echo "============================================================"

# Activate environment
export GEOTIFF_CSV="${GEOTIFF_CSV:-}"
set +u
source activate streetview
set -u

# Paths
SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
TEST_CSV="${SPLITS_DIR}/dataset_test.csv"
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"
CONCEPT_DATA="data/concept_data_v2"
OUTPUT_DIR="${OUTPUT_DIR:-comparisons/attention_comparison_$(date +%Y%m%d_%H%M%S)}"
NUM_SAMPLES="${NUM_SAMPLES:-10}"

# Checkpoints to compare (can be overridden via --export)
# Top 6 models based on test Acc@1 performance:
# 1. textinit_tau0.15_k3_stk0.50_lk5: Acc@1=0.4358, Acc@5=0.7319 (BEST - textinit)
# 2. two_stage_tau0.25_k6_stk0.40_lk5_div0.0: Acc@1=0.4157, Acc@5=0.7122
# 3. two_stage_tau0.25_k6_stk0.0_lk5_div1.0: Acc@1=0.4084, Acc@5=0.7099
# 4. simple_tau0.25_k8_stk0.40_lk5_div0.0: Acc@1=0.4062, Acc@5=0.7115
# 5. simple_tau0.25_k6_stk0.40_lk5_div1.0 (reruns): Acc@1=0.3991, Acc@5=0.7120
# 6. simple_tau0.25_k7_stk0.40_lk5_div0.5 (reruns): Acc@1=0.3980, Acc@5=0.7004
CHECKPOINTS=(
    "${CHECKPOINT_1:-checkpoints/phase1_textinit/cbm_stage_1_textinit_visinit_interpretable_tau0.15_k3_stk0.50_lk5}"
    "${CHECKPOINT_2:-checkpoints/phase1_architectures/cbm_stage_1_two_stage_tau0.25_k6_stk0.40_lk5_div0.0}"
    "${CHECKPOINT_3:-checkpoints/phase1_architectures/cbm_stage_1_two_stage_tau0.25_k6_stk0.0_lk5_div1.0}"
    "${CHECKPOINT_4:-checkpoints/phase1_architectures/cbm_stage_1_simple_tau0.25_k8_stk0.40_lk5_div0.0}"
    "${CHECKPOINT_5:-checkpoints/reruns/rerun_20251225_184801/SIMPLE_DIM256/PHASE1_SIMPLE_DIM256_TAU0.25_K6_STK0.40_LK5_DIV1.0}"
    "${CHECKPOINT_6:-checkpoints/reruns/rerun_20251225_184801/SIMPLE_DIM256/PHASE1_SIMPLE_DIM256_TAU0.25_K7_STK0.40_LK5_DIV0.5}"
)

echo "============================================================"
echo "Attention Comparison Script"
echo "============================================================"
echo "Test CSV: $TEST_CSV"
echo "Output: $OUTPUT_DIR"
echo "Samples: $NUM_SAMPLES"
echo ""
echo "Models to compare:"
for cp in "${CHECKPOINTS[@]}"; do
    echo "  - $cp"
done
echo "============================================================"

python scripts/evaluation/compare_attention_models.py \
    --checkpoints "${CHECKPOINTS[@]}" \
    --test-csv "$TEST_CSV" \
    --cached-dir "$CACHED_DIR" \
    --concept-data-dir "$CONCEPT_DATA" \
    --output-dir "$OUTPUT_DIR" \
    --num-samples "$NUM_SAMPLES" \
    --device cuda

echo ""
echo "============================================================"
echo "Comparison complete!"
echo "Results saved to: $OUTPUT_DIR"
echo "============================================================"



