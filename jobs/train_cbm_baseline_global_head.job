#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=cbm_baseline_gh
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=18:00:00
#SBATCH --output=jobs/outputs/cbm_baseline_global_head_%j.out

set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"
mkdir -p jobs/outputs

echo "============================================================"
echo "Activating environment"
echo "============================================================"

# Activate environment
export GEOTIFF_CSV="${GEOTIFF_CSV:-}"
set +u
source activate streetview
set -u

wandb_api_key="9073a011764cb23fce5384443a3996ca9c5d9198"
export WANDB_API_KEY="$wandb_api_key"

# Paths
SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
TRAIN_CSV="${SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${SPLITS_DIR}/dataset_val.csv"

# Cached embeddings (must already exist, including pooled embeddings)
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"

# Concept vocab/priors
CONCEPT_DATA="data/concept_data_v2"

# ============================================================
# Baseline Configuration with Global Head
# ============================================================
MIX_DEPTH=1                    # Baseline depth (original shallow MIL)
MIX_HEADS=4                    # Standard number of attention heads
MIX_MLP_RATIO=4.0              # MLP expansion ratio
CONCEPT_DIM=256                # Concept embedding dimension

# MIL settings
TAU=0.25                       # Temperature for LogSumExp pooling
TOPK=6                         # Top-K patches for MIL
STK_MASK_PROB=0.4              # STKIM mask probability
STK_K_MASK=1                   # STKIM K mask
MIX_LOCAL_KERNEL=0             # 0 = no local kernel (full attention)
PROJ_TYPE=simple               # Simple projection

# Regularization
DROPOUT=0.3                    # Dropout
WEIGHT_DECAY=0.05              # Weight decay
EARLY_STOP_PATIENCE=10         # Early stopping patience

# No diversity loss
ATTN_DIV_W=0.0

# Training settings
LR=5e-5                        # Learning rate
EPOCHS=100                     # Number of epochs
BATCH_SIZE=64                  # Batch size
WARMUP_EPOCHS=8                # Warmup epochs

# Positional encoding
USE_POS_ENCODING=true          # Enable positional encoding
MAX_PATCHES=576                # Maximum number of patches

# Per-concept adaptive temperature (disabled for baseline)
USE_PER_CONCEPT_TAU=false

# Global head settings (ENABLED - this is the key difference from baseline)
USE_GLOBAL_HEAD=true           # Enable global head using CLS token
POOLED_DIM=768                 # Dimension of pooled embeddings (StreetCLIP default)

# Wandb run name
WANDB_RUN_NAME="baseline_global_head_d${MIX_DEPTH}_h${MIX_HEADS}_dim${CONCEPT_DIM}_pos"

RUN_TAG="baseline_global_head_d${MIX_DEPTH}_h${MIX_HEADS}_dim${CONCEPT_DIM}_pos"
OUTPUT_DIR="checkpoints/phase1_baseline_global_head/${RUN_TAG}"
CONCEPT_MAPPING="data/concept_refinement_mapped.csv"

# --------------------------------------------------------------------------------------
# Per-job working directory to avoid race conditions
# --------------------------------------------------------------------------------------
RUN_ID="${SLURM_JOB_ID:-local_$(date +%Y%m%d_%H%M%S)}"
RUN_WORKDIR="${OUTPUT_DIR}/run_${RUN_ID}"
RUN_SPLITS_DIR="${RUN_WORKDIR}/splits"
RUN_CONCEPT_DATA="${RUN_WORKDIR}/concept_data_v2"

mkdir -p "$OUTPUT_DIR" "$RUN_SPLITS_DIR" "$RUN_CONCEPT_DATA"

# Copy split CSVs
for split in train val test; do
  src="${SPLITS_DIR}/dataset_${split}.csv"
  if [[ -f "${src}.bak" ]]; then
    cp "${src}.bak" "${RUN_SPLITS_DIR}/dataset_${split}.csv"
  else
    cp "$src" "${RUN_SPLITS_DIR}/dataset_${split}.csv"
  fi
done

# Check if cached embeddings exist (including pooled embeddings for global head)
if [[ ! -f "$CACHED_DIR/train_patch_tokens.pt" || ! -f "$CACHED_DIR/train_metadata.json" ]]; then
  echo "ERROR: Cached patch tokens not found in $CACHED_DIR"
  echo "Please run precompute_streetclip_embeddings.py first"
  exit 1
fi

if [[ "$USE_GLOBAL_HEAD" == "true" ]]; then
  if [[ ! -f "$CACHED_DIR/train_pooled_embeddings.pt" ]]; then
    echo "ERROR: Cached pooled embeddings not found in $CACHED_DIR/train_pooled_embeddings.pt"
    echo "Global head requires pooled embeddings. Please ensure they were computed."
    exit 1
  fi
  echo "Global head enabled: Using pooled embeddings from $CACHED_DIR"
fi

SPLITS_DIR="$RUN_SPLITS_DIR"
TRAIN_CSV="${SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${SPLITS_DIR}/dataset_val.csv"
CONCEPT_DATA="$RUN_CONCEPT_DATA"

echo "============================================================"
echo "Step 0: Mapping meta_name -> generalized concepts"
echo "============================================================"
python scripts/data_processing/map_generalized_concepts.py \
  --splits-dir "$SPLITS_DIR" \
  --mapping "$CONCEPT_MAPPING"

echo "============================================================"
echo "Step 1: Precomputing concept vocab + geo priors"
echo "============================================================"
python scripts/data_processing/precompute_geo_priors.py \
  --train-csv "$TRAIN_CSV" \
  --output-dir "$CONCEPT_DATA" \
  --s2-level 8

echo "============================================================"
echo "Step 2: Ensure cached StreetCLIP embeddings exist"
echo "============================================================"

echo "============================================================"
echo "Step 3: Train Phase 1 Baseline with Global Head (CLS-based)"
echo "  - head_type: topk_mil"
echo "  - mix_depth: ${MIX_DEPTH} (BASELINE - original shallow)"
echo "  - mix_heads: ${MIX_HEADS}"
echo "  - mix_mlp_ratio: ${MIX_MLP_RATIO}"
echo "  - concept_dim: ${CONCEPT_DIM}"
echo "  - mil_topk: ${TOPK}"
echo "  - attn_tau: ${TAU}"
echo "  - use_global_head: ${USE_GLOBAL_HEAD} (ENABLED)"
echo "  - pooled_dim: ${POOLED_DIM}"
echo "  - use_pos_encoding: ${USE_POS_ENCODING}"
echo "============================================================"

python -m cbm.phase1.train \
  --train-csv "$TRAIN_CSV" \
  --val-csv "$VAL_CSV" \
  --cached-dir "$CACHED_DIR" \
  --concept-data-dir "$CONCEPT_DATA" \
  --output-dir "$OUTPUT_DIR" \
  --epochs "$EPOCHS" \
  --batch-size "$BATCH_SIZE" \
  --lr "$LR" \
  --warmup-epochs "$WARMUP_EPOCHS" \
  --wandb \
  --wandb-run-name "$WANDB_RUN_NAME" \
  --head-type topk_mil \
  --concept-dim "$CONCEPT_DIM" \
  --attn-tau "$TAU" \
  --mil-topk "$TOPK" \
  --mix-depth "$MIX_DEPTH" \
  --mix-heads "$MIX_HEADS" \
  --mix-mlp-ratio "$MIX_MLP_RATIO" \
  --mix-local-kernel-size "$MIX_LOCAL_KERNEL" \
  --dropout "$DROPOUT" \
  --weight-decay "$WEIGHT_DECAY" \
  --selection-metric acc1 \
  --stk-mask-prob "$STK_MASK_PROB" \
  --stk-k-mask "$STK_K_MASK" \
  --proj-type "$PROJ_TYPE" \
  --attn-diversity-weight "$ATTN_DIV_W" \
  --early-stop-patience "$EARLY_STOP_PATIENCE" \
  --max-patches "$MAX_PATCHES" \
  --use-pos-encoding \
  --use-global-head \
  --pooled-dim "$POOLED_DIM"

echo "============================================================"
echo "Training complete! (Baseline + Global Head)"
echo "Outputs: $OUTPUT_DIR"
echo "============================================================"

BEST_CHECKPOINT="${OUTPUT_DIR}/phase1/best_phase1.pt"
TEST_CSV="${RUN_SPLITS_DIR}/dataset_test.csv"
EVAL_OUTPUT_DIR="${OUTPUT_DIR}/test_evaluation"

if [[ ! -f "$BEST_CHECKPOINT" ]]; then
  echo "WARNING: Best checkpoint not found at $BEST_CHECKPOINT"
  echo "Skipping evaluation."
  exit 0
fi

echo "============================================================"
echo "Step 4: Evaluating on Test Set with Visualizations"
echo "============================================================"
echo "Checkpoint: $BEST_CHECKPOINT"
echo "Test CSV: $TEST_CSV"
echo "Output: $EVAL_OUTPUT_DIR"
echo "============================================================"

mkdir -p "$EVAL_OUTPUT_DIR"

python -m cbm.phase1.eval \
  --checkpoint "$BEST_CHECKPOINT" \
  --test-csv "$TEST_CSV" \
  --cached-dir "$CACHED_DIR" \
  --concept-data-dir "$CONCEPT_DATA" \
  --output-dir "$EVAL_OUTPUT_DIR" \
  --head-type topk_mil \
  --concept-dim "$CONCEPT_DIM" \
  --dropout "$DROPOUT" \
  --mil-topk "$TOPK" \
  --mil-tau "$TAU" \
  --mix-depth "$MIX_DEPTH" \
  --mix-heads "$MIX_HEADS" \
  --mix-mlp-ratio "$MIX_MLP_RATIO" \
  --mix-local-kernel-size "$MIX_LOCAL_KERNEL" \
  --proj-type "$PROJ_TYPE" \
  --batch-size 64 \
  --num-workers 4 \
  --max-patches "$MAX_PATCHES" \
  --use-pos-encoding \
  --use-global-head \
  --pooled-dim "$POOLED_DIM" \
  --generate-visualizations \
  --num-viz-samples 20 \
  --device cuda

echo "============================================================"
echo "Evaluation complete!"
echo "Results: $EVAL_OUTPUT_DIR"
echo "============================================================"

