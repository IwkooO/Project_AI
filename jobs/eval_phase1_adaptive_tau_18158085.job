#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=eval_adaptive_tau
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=2:00:00
#SBATCH --output=jobs/outputs/eval_phase1_adaptive_tau_%j.out

set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"
mkdir -p jobs/outputs

# Activate env
export GEOTIFF_CSV="${GEOTIFF_CSV:-}"
set +u
source activate streetview
set -u

# Paths
CHECKPOINT="/home/igodzwon/Project_AI/checkpoints/phase1_adaptive_tau/adaptive_tau_d1_h4_dim256_pos_stk0.0/phase1/best_phase1.pt"
TEST_CSV="/home/igodzwon/Project_AI/checkpoints/phase1_adaptive_tau/adaptive_tau_d1_h4_dim256_pos_stk0.0/run_18158085/splits/dataset_test.csv"
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"
CONCEPT_DATA="/home/igodzwon/Project_AI/checkpoints/phase1_adaptive_tau/adaptive_tau_d1_h4_dim256_pos_stk0.0/run_18158085/concept_data_v2"
OUTPUT_DIR="/home/igodzwon/Project_AI/checkpoints/phase1_adaptive_tau/adaptive_tau_d1_h4_dim256_pos_stk0.0/test_evaluation"

# Model config (matching training)
CONCEPT_DIM=256
MIX_DEPTH=1
MIX_HEADS=4
MIX_MLP_RATIO=2.0
DROPOUT=0.3
MIL_TAU=0.25
MIL_TOPK=6
MAX_PATCHES=576

echo "============================================================"
echo "Evaluating on Test Set with Visualizations"
echo "============================================================"
echo "Checkpoint: $CHECKPOINT"
echo "Test CSV: $TEST_CSV"
echo "Output: $OUTPUT_DIR"
echo "============================================================"

mkdir -p "$OUTPUT_DIR"

python -m cbm.phase1.eval \
  --checkpoint "$CHECKPOINT" \
  --test-csv "$TEST_CSV" \
  --cached-dir "$CACHED_DIR" \
  --concept-data-dir "$CONCEPT_DATA" \
  --output-dir "$OUTPUT_DIR" \
  --concept-dim "$CONCEPT_DIM" \
  --dropout "$DROPOUT" \
  --mil-topk "$MIL_TOPK" \
  --mil-tau "$MIL_TAU" \
  --mix-depth "$MIX_DEPTH" \
  --mix-heads "$MIX_HEADS" \
  --mix-mlp-ratio "$MIX_MLP_RATIO" \
  --use-pos-encoding \
  --max-patches "$MAX_PATCHES" \
  --use-per-concept-tau \
  --batch-size 64 \
  --num-workers 4 \
  --generate-visualizations \
  --num-viz-samples 20 \
  --device cuda

echo "============================================================"
echo "Evaluation complete!"
echo "Results saved to: $OUTPUT_DIR"
echo "============================================================"

