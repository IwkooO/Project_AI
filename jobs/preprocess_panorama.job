#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=preprocess_pano
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=12:00:00
#SBATCH --mem=32GB
#SBATCH --output=jobs/outputs/preprocess_pano.log
#SBATCH --dependency=afterok:16859997

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/Project_AI/
source activate streetview

# Define paths
PANORAMA_FOLDER="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/panorama"
OUTPUT_FOLDER="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/panorama_processed"

# Create output folder if it doesn't exist
mkdir -p "$OUTPUT_FOLDER"

python scripts/data_processing/preprocess_panorama.py \
    --panorama-folder "$PANORAMA_FOLDER" \
    --output-folder "$OUTPUT_FOLDER"


