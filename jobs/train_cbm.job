#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=cbm_train
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=12:00:00
#SBATCH --output=jobs/outputs/cbm_train_%j.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/Project_AI/

# Activate environment
source activate streetview
pip install wandb
wandb_api_key="9073a011764cb23fce5384443a3996ca9c5d9198"
export WANDB_API_KEY="$wandb_api_key"
# Paths
SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
TRAIN_CSV="${SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${SPLITS_DIR}/dataset_val.csv"
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip"
CONCEPT_DATA="data/concept_data"
OUTPUT_DIR="checkpoints/cbm_v2"
CONCEPT_MAPPING="data/concept_refinement_mapped.csv"

mkdir -p jobs/outputs
mkdir -p $OUTPUT_DIR
mkdir -p $CONCEPT_DATA

# Step 0: Map meta_name to generalized concepts
echo "============================================================"
echo "Step 0: Mapping meta_name to generalized concepts"
echo "============================================================"
python scripts/data_processing/map_generalized_concepts.py \
    --splits-dir $SPLITS_DIR \
    --mapping $CONCEPT_MAPPING

# Step 1: Precompute geo priors and concept vocabulary
echo "============================================================"
echo "Step 1: Precomputing concept vocabulary and geo priors"
echo "============================================================"
python scripts/data_processing/precompute_geo_priors.py \
    --train-csv $TRAIN_CSV \
    --output-dir $CONCEPT_DATA \
    --s2-level 8

# Step 1.5: Precompute embeddings (including patch tokens)
echo "============================================================"
echo "Step 1.5: Precomputing embeddings & patch tokens (SKIPPED)"
echo "============================================================"
# python scripts/data_processing/precompute_streetclip_embeddings.py \
#     --train-csv $TRAIN_CSV \
#     --val-csv $VAL_CSV \
#     --output-dir $CACHED_DIR \
#     --batch-size 32 \
#     --save-patch-tokens

# Phase 1: Concept Training (with stability fixes)
echo "============================================================"
echo "Starting Phase 1: Concept Training"
echo "============================================================"
python scripts/training/train_cbm.py \
    --phase 1 \
    --train-csv $TRAIN_CSV \
    --val-csv $VAL_CSV \
    --cached-dir $CACHED_DIR \
    --concept-data-dir $CONCEPT_DATA \
    --output-dir $OUTPUT_DIR \
    --epochs 80 \
    --batch-size 64 \
    --lr 5e-4 \
    --warmup-epochs 5 \
    --wandb \
    --load-patch-tokens \
    --geo-aware-supcon --supcon-geo-scale 0.3 \
    --patch-depth 2 --patch-heads 4 --num-pool-heads 4

# Phase 2: Geo Training (DISABLED - Model simplified for Phase 1 only)
# echo "============================================================"
# echo "Starting Phase 2: Geo Training (resuming from Phase 1)"
# echo "============================================================"
# python scripts/training/train_cbm.py \
#     --phase 2 \
#     --resume-checkpoint $OUTPUT_DIR/phase1/best_phase1.pt \
#     --train-csv $TRAIN_CSV \
#     --val-csv $VAL_CSV \
#     --cached-dir $CACHED_DIR \
#     --concept-data-dir $CONCEPT_DATA \
#     --output-dir $OUTPUT_DIR \
#     --epochs 50 \
#     --batch-size 128 \
#     --lr 5e-4 \
#     --warmup-epochs 3 \
#     --wandb \
#     --load-patch-tokens \
#     --patch-depth 2 --patch-heads 4 --num-pool-heads 4

# Phase 3: Joint Training (DISABLED - Model simplified for Phase 1 only)
# echo "============================================================"
# echo "Starting Phase 3: Joint Training (fine-tuning)"
# echo "============================================================"
# python scripts/training/train_cbm.py \
#     --phase 3 \
#     --resume-checkpoint $OUTPUT_DIR/phase2/best_phase2.pt \
#     --train-csv $TRAIN_CSV \
#     --val-csv $VAL_CSV \
#     --cached-dir $CACHED_DIR \
#     --concept-data-dir $CONCEPT_DATA \
#     --output-dir $OUTPUT_DIR \
#     --epochs 50 \
#     --batch-size 64 \
#     --lr 1e-4 \
#     --warmup-epochs 3 \
#     --wandb \
#     --load-patch-tokens \
#     --geo-aware-supcon --supcon-geo-scale 0.3 \
#     --patch-depth 2 --patch-heads 4 --num-pool-heads 4

echo "============================================================"
echo "Training complete! Phase 1 (Concept Prediction) finished."
echo "Note: Phase 2 and 3 are disabled - model simplified for Phase 1 only."
echo "============================================================"
