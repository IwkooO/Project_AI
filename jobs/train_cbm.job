#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=train_cbm
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=12:00:00
#SBATCH --mem=32GB
#SBATCH --output=jobs/outputs/train/train_cbm_%j.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/Project_AI/
source activate streetview

# Upgrade torch to >= 2.6 to fix security vulnerability error
#pip install "torch>=2.6" torchvision --upgrade

# Create output directories
mkdir -p jobs/outputs/train
mkdir -p checkpoints/cbm
mkdir -p visualizations/cbm

# Run training
# Using the specific dataset CSV path we verified earlier
DATASET_CSV="$HOME/Project_AI/data/691df1ee911f74393c53af8c/dataset.csv"
PROBE_PATH="checkpoints/probe/best_probe_model.pth"

echo "Starting CBM training..."
echo "Dataset: $DATASET_CSV"
echo "Loading Probe from: $PROBE_PATH"

python -u scripts/training/train_cbm.py \
    --csv-path "$DATASET_CSV" \
    --probe-path "$PROBE_PATH" \
    --batch-size 128 \
    --backbone-bs 64 \
    --pretrained-model-path "checkpoints/cbm/best_cbm_model.pth" \
    --num-workers 12 \
    --epochs 20 \
    --lr 2e-3 \
    --w-coords 1.0 \
    --w-country 1.0 \
    --w-concepts 0.5 \
    --unfreeze-epoch 1 \
    --backbone-lr 1e-5 \
    --output-dir "checkpoints/cbm-finetuned"

echo "Training finished."
