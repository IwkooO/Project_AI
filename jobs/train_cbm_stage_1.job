#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=cbm_qtopk128_na
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=12:00:00
#SBATCH --output=jobs/outputs/cbm_stage_1_simple_local_stk0.4_%j.out

set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"
mkdir -p jobs/outputs

echo "============================================================"
echo "Activating environment"
echo "============================================================"

# Activate environment
export GEOTIFF_CSV="${GEOTIFF_CSV:-}"
set +u
source activate streetview
set -u

wandb_api_key="9073a011764cb23fce5384443a3996ca9c5d9198"
export WANDB_API_KEY="$wandb_api_key"

# Paths
SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
TRAIN_CSV="${SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${SPLITS_DIR}/dataset_val.csv"

# Cached embeddings (must already exist)
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"

# Concept vocab/priors
CONCEPT_DATA="data/concept_data_v2"

# Output directory
TAU="${TAU:-0.25}"
TOPK="${TOPK:-6}"
STK_MASK_PROB="${STK_MASK_PROB:-0.4}"
STK_K_MASK="${STK_K_MASK:-1}"
MIX_LOCAL_KERNEL="${MIX_LOCAL_KERNEL:-5}"
PROJ_TYPE="${PROJ_TYPE:-simple}"

# Regularization: Use higher dropout/weight decay for two_stage to prevent overfitting
# two_stage has more capacity (patch_dim -> patch_dim -> concept_dim) so needs more regularization
if [[ "$PROJ_TYPE" == "two_stage" ]]; then
  DROPOUT="${DROPOUT:-0.4}"  # Higher dropout for two_stage (default 0.3 for others)
  WEIGHT_DECAY="${WEIGHT_DECAY:-0.08}"  # Higher weight decay for two_stage (default 0.05 for others)
  EARLY_STOP_PATIENCE="${EARLY_STOP_PATIENCE:-7}"  # More aggressive early stopping for two_stage (default 10)
else
  DROPOUT="${DROPOUT:-0.3}"
  WEIGHT_DECAY="${WEIGHT_DECAY:-0.05}"
  EARLY_STOP_PATIENCE="${EARLY_STOP_PATIENCE:-10}"
fi

# Optional attention diversity loss (default: disabled)
ATTN_DIV_W="${ATTN_DIV_W:-1.0}"
ATTN_DIV_TOPM="${ATTN_DIV_TOPM:-8}"
ATTN_DIV_WARMUP="${ATTN_DIV_WARMUP:-5}"
ATTN_DIV_MODE="${ATTN_DIV_MODE:-offdiag}"  # offdiag|full

# Wandb run name (optional, defaults to phase1_{run_id} in training script)
WANDB_RUN_NAME="${WANDB_RUN_NAME:-}"

RUN_TAG="tau${TAU}_k${TOPK}_stk${STK_MASK_PROB}_lk${MIX_LOCAL_KERNEL}_div${ATTN_DIV_W}"
OUTPUT_DIR="${OUTPUT_DIR:-checkpoints/phase1_architectures/cbm_stage_1_${PROJ_TYPE}_${RUN_TAG}}"
CONCEPT_MAPPING="data/concept_refinement_mapped.csv"

# --------------------------------------------------------------------------------------
# IMPORTANT: Avoid race conditions in sweeps.
# We NEVER write back into the shared splits dir or shared concept_data dir.
# Instead, we copy splits into a per-job working directory and generate priors there.
# --------------------------------------------------------------------------------------
RUN_ID="${SLURM_JOB_ID:-local_$(date +%Y%m%d_%H%M%S)}"
RUN_WORKDIR="${OUTPUT_DIR}/run_${RUN_ID}"
RUN_SPLITS_DIR="${RUN_WORKDIR}/splits"
RUN_CONCEPT_DATA="${RUN_WORKDIR}/concept_data_v2"

mkdir -p "$OUTPUT_DIR" "$RUN_SPLITS_DIR" "$RUN_CONCEPT_DATA"

# Copy split CSVs (prefer .bak if present to recover from accidental in-place edits)
for split in train val test; do
  src="${SPLITS_DIR}/dataset_${split}.csv"
  if [[ -f "${src}.bak" ]]; then
    cp "${src}.bak" "${RUN_SPLITS_DIR}/dataset_${split}.csv"
  else
    cp "${src}" "${RUN_SPLITS_DIR}/dataset_${split}.csv"
  fi
done

# Point the run at the per-job splits/concept data
SPLITS_DIR="$RUN_SPLITS_DIR"
TRAIN_CSV="${SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${SPLITS_DIR}/dataset_val.csv"
CONCEPT_DATA="$RUN_CONCEPT_DATA"

echo "============================================================"
echo "Step 0: Mapping meta_name -> generalized concepts"
echo "============================================================"
python scripts/data_processing/map_generalized_concepts.py \
  --splits-dir "$SPLITS_DIR" \
  --mapping "$CONCEPT_MAPPING"

echo "============================================================"
echo "Step 1: Precomputing concept vocab + geo priors"
echo "============================================================"
python scripts/data_processing/precompute_geo_priors.py \
  --train-csv "$TRAIN_CSV" \
  --output-dir "$CONCEPT_DATA" \
  --s2-level 8

echo "============================================================"
echo "Step 2: Ensure cached StreetCLIP embeddings exist"
echo "============================================================"
if [[ ! -f "$CACHED_DIR/train_pooled_embeddings.pt" || ! -f "$CACHED_DIR/train_metadata.json" || ! -f "$CACHED_DIR/train_patch_tokens.pt" ]]; then
  echo "ERROR: Missing cached embeddings in $CACHED_DIR"
  echo "Run scripts/data_processing/precompute_streetclip_embeddings.py first."
  exit 1
fi

echo "============================================================"
echo "Step 3: Train Phase 1 concept head (QueryTopK256 + Neighborhood Attention)"
echo "  - concept_dim=256 (learned projection + concept queries from scratch)"
echo "  - mix_local_kernel_size=5 (Chebyshev KxK neighborhood)"
echo "============================================================"
python -m cbm.phase1.train \
  --train-csv "$TRAIN_CSV" \
  --val-csv "$VAL_CSV" \
  --cached-dir "$CACHED_DIR" \
  --concept-data-dir "$CONCEPT_DATA" \
  --output-dir "$OUTPUT_DIR" \
  --epochs 80 \
  --batch-size 64 \
  --lr 7e-5 \
  --warmup-epochs 5 \
  --wandb \
  ${WANDB_RUN_NAME:+--wandb-run-name "$WANDB_RUN_NAME"} \
  --concept-dim 256 \
  --attn-tau "$TAU" \
  --mil-topk "$TOPK" \
  --mix-depth 1 --mix-heads 4 --mix-mlp-ratio 2.0 \
  --mix-local-kernel-size "$MIX_LOCAL_KERNEL" \
  --dropout "$DROPOUT" --weight-decay "$WEIGHT_DECAY" \
  --selection-metric acc1 \
  --stk-mask-prob "$STK_MASK_PROB" \
  --stk-k-mask "$STK_K_MASK" \
  --proj-type "$PROJ_TYPE" \
  --attn-diversity-weight "$ATTN_DIV_W" \
  --attn-diversity-topm "$ATTN_DIV_TOPM" \
  --attn-diversity-warmup-epochs "$ATTN_DIV_WARMUP" \
  --attn-diversity-mode "$ATTN_DIV_MODE" \
  --early-stop-patience "$EARLY_STOP_PATIENCE"


echo "============================================================"
echo "Training complete! (QueryTopK256 + Neighborhood Attention)"
echo "Outputs: $OUTPUT_DIR"
echo "============================================================"

# Check if best checkpoint exists before evaluation
BEST_CHECKPOINT="${OUTPUT_DIR}/phase1/best_phase1.pt"
TEST_CSV="${SPLITS_DIR}/dataset_test.csv"
EVAL_OUTPUT_DIR="${OUTPUT_DIR}/test_evaluation"

if [[ ! -f "$BEST_CHECKPOINT" ]]; then
  echo "WARNING: Best checkpoint not found at $BEST_CHECKPOINT"
  echo "Skipping test set evaluation."
  exit 0
fi

if [[ ! -f "$TEST_CSV" ]]; then
  echo "WARNING: Test CSV not found at $TEST_CSV"
  echo "Skipping test set evaluation."
  exit 0
fi

echo "============================================================"
echo "Step 4: Evaluating on Test Set with Visualizations"
echo "============================================================"
echo "Checkpoint: $BEST_CHECKPOINT"
echo "Test CSV: $TEST_CSV"
echo "Output: $EVAL_OUTPUT_DIR"
echo "============================================================"

mkdir -p "$EVAL_OUTPUT_DIR"

python -m cbm.phase1.eval \
  --checkpoint "$BEST_CHECKPOINT" \
  --test-csv "$TEST_CSV" \
  --cached-dir "$CACHED_DIR" \
  --concept-data-dir "$CONCEPT_DATA" \
  --output-dir "$EVAL_OUTPUT_DIR" \
  --concept-dim 256 \
  --dropout "$DROPOUT" \
  --mil-topk "$TOPK" \
  --mil-tau "$TAU" \
  --mix-depth 1 \
  --mix-heads 4 \
  --mix-mlp-ratio 2.0 \
  --mix-local-kernel-size "$MIX_LOCAL_KERNEL" \
  --proj-type "$PROJ_TYPE" \
  --batch-size 64 \
  --num-workers 4 \
  --generate-visualizations \
  --num-viz-samples 20 \
  --device cuda

echo "============================================================"
echo "Test evaluation complete!"
echo "Results saved to: $EVAL_OUTPUT_DIR"
echo "Metrics: $EVAL_OUTPUT_DIR/metrics.json"
echo "Visualizations: $EVAL_OUTPUT_DIR/visualizations/"
echo "============================================================"

