#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=train_sae
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=4:00:00
#SBATCH --mem=32GB
#SBATCH --output=jobs/outputs/train/train_sae_fast.out
#SBATCH --dependency=afterok:16913394

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/Project_AI/
source activate streetview

# Parameters
DATASET_DIR="$HOME/Project_AI/data/6921d7831744c5356b098bf7_balanced"
CACHED_DIR="$DATASET_DIR/cached_embeddings_augmented"
TRAIN_PT="$CACHED_DIR/train_embeddings.pt"
VAL_PT="$CACHED_DIR/val_embeddings.pt"

# We still need CSVs for visualization later
TRAIN_CSV="$DATASET_DIR/splits/dataset_train.csv"
VAL_CSV="$DATASET_DIR/splits/dataset_val.csv"

OUTPUT_DIR="checkpoints/sae_fast"
VIZ_DIR="visualizations/sae_concepts_fast"

mkdir -p jobs/outputs/train
mkdir -p $OUTPUT_DIR
mkdir -p $VIZ_DIR

echo "----------------------------------------------------------------"
echo "Job started at: $(date)"
echo "Using Cached Embeddings from: $CACHED_DIR"
echo "Output: $OUTPUT_DIR"
echo "----------------------------------------------------------------"

# 1. Train SAE (Fast Mode)
echo "Starting SAE Training..."
python -u scripts/training/train_sae.py \
    --csv-path "$TRAIN_CSV" \
    --val-csv-path "$VAL_CSV" \
    --output-dir "$OUTPUT_DIR" \
    --use-cached \
    --cached-train-path "$TRAIN_PT" \
    --cached-val-path "$VAL_PT" \
    --batch-size 256 \
    --lr 1e-4 \
    --epochs 50 \
    --expansion 4 \
    --k 32 \
    --resample-freq 5

echo "Training finished at: $(date)"

# 2. Visualize Concepts
# Use the BEST checkpoint
CHECKPOINT="$OUTPUT_DIR/best_sae.pth"

if [ -f "$CHECKPOINT" ]; then
    echo "Starting Concept Visualization..."
    python -u scripts/evaluation/visualize_sae_concepts.py \
        --sae-path "$CHECKPOINT" \
        --csv-path "$VAL_CSV" \
        --output-dir "$VIZ_DIR" \
        --num-concepts 20 \
        --top-k-images 9
else
    echo "Checkpoint not found, skipping visualization."
fi

echo "Job finished at: $(date)"

