#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=cbm_train_mil_mixed
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=12:00:00
#SBATCH --output=jobs/outputs/cbm_train_mil_mixed_%j_new_but_8.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/Project_AI/

# Activate environment
source activate streetview
wandb_api_key="9073a011764cb23fce5384443a3996ca9c5d9198"
export WANDB_API_KEY="$wandb_api_key"

# Paths
SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
TRAIN_CSV="${SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${SPLITS_DIR}/dataset_val.csv"
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip"
CONCEPT_DATA="data/concept_data"
OUTPUT_DIR="checkpoints/cbm_v2_mil_mixed_regularization"
CONCEPT_MAPPING="data/concept_refinement_mapped.csv"

mkdir -p jobs/outputs
mkdir -p $OUTPUT_DIR
mkdir -p $CONCEPT_DATA

# Step 0: Map meta_name to generalized concepts
echo "============================================================"
echo "Step 0: Mapping meta_name to generalized concepts"
echo "============================================================"
python scripts/data_processing/map_generalized_concepts.py \
    --splits-dir $SPLITS_DIR \
    --mapping $CONCEPT_MAPPING

# Step 1: Precompute geo priors and concept vocabulary
echo "============================================================"
echo "Step 1: Precomputing concept vocabulary and geo priors"
echo "============================================================"
python scripts/data_processing/precompute_geo_priors.py \
    --train-csv $TRAIN_CSV \
    --output-dir $CONCEPT_DATA \
    --s2-level 8

# Phase 1: Concept Training (MIL + 1-layer patch mixer)
echo "============================================================"
echo "Starting Phase 1: Concept Training (MIL + patch mixing)"
echo "============================================================"
python scripts/training/train_cbm.py \
    --phase 1 \
    --train-csv $TRAIN_CSV \
    --val-csv $VAL_CSV \
    --cached-dir $CACHED_DIR \
    --concept-data-dir $CONCEPT_DATA \
    --output-dir $OUTPUT_DIR \
    --epochs 80 \
    --batch-size 64 \
    --lr 7e-5 \
    --warmup-epochs 5 \
    --wandb \
    --load-patch-tokens \
    --model mil_mixed \
    --concept-dim 256 \
    --mil-topk 16 \
    --mil-tau 0.3 \
    --mix-depth 1 --mix-heads 4 --mix-mlp-ratio 2.0 \
    --mix-dropout 0.2 \
    --dropout 0.4 --weight-decay 0.05 \
    --geo-aware-supcon --supcon-geo-scale 0.3

echo "============================================================"
echo "Training complete! Phase 1 finished."
echo "============================================================"

