#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=clip_diagnose
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=2:00:00
#SBATCH --mem=32GB
#SBATCH --output=jobs/outputs/diagnose_clip_%j.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/Project_AI/
source activate streetview

# Use persistent HuggingFace cache
export HF_HOME="$HOME/.cache/huggingface"
export TRANSFORMERS_CACHE="$HF_HOME"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
mkdir -p "$HF_HOME"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

# Configuration
DATA_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced"
HOME_DATA_DIR="$HOME/Project_AI/data/6921d7831744c5356b098bf7_balanced"

DATASET_CSV="$HOME_DATA_DIR/dataset.csv"
CACHED_DIR="$DATA_DIR/cached_streetclip"
CONCEPT_DIR="$DATA_DIR/concept_data"
OUTPUT_DIR="$HOME/Project_AI/analysis/clip_similarities"
SPLIT="val"
NUM_SAMPLES=20

mkdir -p "$OUTPUT_DIR"
mkdir -p jobs/outputs

echo "============================================================"
echo "CLIP Similarity Diagnostic"
echo "============================================================"
echo "Dataset: $DATASET_CSV"
echo "Split: $SPLIT"
echo "Output: $OUTPUT_DIR"
echo "============================================================"

python -u scripts/analysis/diagnose_clip_similarities.py \
    --dataset-csv "$DATASET_CSV" \
    --cached-embeddings-dir "$CACHED_DIR" \
    --concept-data-dir "$CONCEPT_DIR" \
    --split "$SPLIT" \
    --num-samples $NUM_SAMPLES \
    --output-dir "$OUTPUT_DIR" \
    --device cuda

if [ $? -ne 0 ]; then
    echo "ERROR: Diagnostic failed"
    exit 1
fi

echo ""
echo "============================================================"
echo "Diagnostic complete!"
echo "============================================================"
echo "Results saved to: $OUTPUT_DIR"
echo "============================================================"

