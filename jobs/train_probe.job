#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=train_probe
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=04:00:00
#SBATCH --mem=32GB
#SBATCH --output=jobs/outputs/train/train_probe_%j.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/Project_AI/
source activate streetview

# Upgrade torch to >= 2.6 to fix security vulnerability error
pip install "torch>=2.6" torchvision --upgrade

# Create output directories
mkdir -p jobs/outputs
mkdir -p checkpoints/probe

# Run training
# Using the specific dataset CSV path we verified earlier
DATASET_CSV="$HOME/Project_AI/data/691df1ee911f74393c53af8c/dataset.csv"

echo "Starting training..."
echo "Dataset: $DATASET_CSV"

python -u scripts/train_probe.py \
    --csv-path "$DATASET_CSV" \
    --batch-size 64 \
    --num-workers 12 \
    --epochs 10 \
    --lr 1e-3 \
    --output-dir "checkpoints/probe"

echo "Training finished."

