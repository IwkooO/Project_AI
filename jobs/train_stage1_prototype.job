#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=stage1_proto
#SBATCH --output=/scratch-shared/pnair/Project_AI/jobs/outputs/train_stage1_prototype.log
#SBATCH --time=24:00:00  
#SBATCH --cpus-per-task=9
#SBATCH --mem=64G

# Activate environment
module load 2025
module load Anaconda3/2025.06-1
cd /scratch-shared/pnair/Project_AI/
module load CUDA/12.8.0

source activate streetview_pnair
export PYTHONNOUSERSITE=1
export PYTHONPATH=/scratch-shared/pnair/Project_AI:$PYTHONPATH

# ===== Stage 1 Configuration =====
STAGE1_EPOCHS=50
BATCH_SIZE=256
LR=3e-4

# Loss weights
LAMBDA_META=1.0
LAMBDA_PARENT=0.3
LAMBDA_CONTRASTIVE=0.5
LAMBDA_REG=0.001

# Focal loss
FOCAL_GAMMA=2.0
LABEL_SMOOTHING=0.1

# Run Stage 1 Training with Text-Prototype Based Concept Learning
python scripts/training/train_stage1_prototype.py \
    --csv_path "/scratch-shared/pnair/Project_AI/data/dataset-43k-mapped.csv" \
    --encoder_model "geolocal/StreetCLIP" \
    --resume_from_checkpoint "/scratch-shared/pnair/Project_AI/results/concept-aware-3-stage/streetclip/global/haversine/2025-12-04_20-07-33/checkpoints/best_model_stage0.pt" \
    --stage1_epochs ${STAGE1_EPOCHS} \
    --batch_size ${BATCH_SIZE} \
    --lr ${LR} \
    --weight_decay 0.01 \
    --lambda_meta ${LAMBDA_META} \
    --lambda_parent ${LAMBDA_PARENT} \
    --lambda_contrastive ${LAMBDA_CONTRASTIVE} \
    --lambda_reg ${LAMBDA_REG} \
    --focal_gamma ${FOCAL_GAMMA} \
    --label_smoothing ${LABEL_SMOOTHING} \
    --temperature 0.07 \
    --init_logit_scale 14.0 \
    --learnable_prototypes \
    --prototype_residual_scale 0.01 \
    --gradient_accumulation_steps 2 \
    --early_stopping_patience 10 \
    --save_interval 5 \
    --use_amp \
    --use_class_weights \
    --precompute_embeddings \
    --use_wandb
