#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=eval_crossattn
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=2:00:00
#SBATCH --output=jobs/outputs/eval_phase1_crossattn_%j.out

set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"
mkdir -p jobs/outputs

# Activate env
export GEOTIFF_CSV="${GEOTIFF_CSV:-}"
set +u
source activate streetview
set -u

# Paths
CHECKPOINT="/home/igodzwon/Project_AI/checkpoints/phase1_crossattn/crossattn_dim256_depth3_heads8_pos/phase1/best_phase1.pt"
TEST_CSV="/home/igodzwon/Project_AI/checkpoints/phase1_crossattn/crossattn_dim256_depth3_heads8_pos/run_18116337/splits/dataset_test.csv"
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"
CONCEPT_DATA="/home/igodzwon/Project_AI/checkpoints/phase1_crossattn/crossattn_dim256_depth3_heads8_pos/run_18116337/concept_data_v2"
OUTPUT_DIR="/home/igodzwon/Project_AI/checkpoints/phase1_crossattn/crossattn_dim256_depth3_heads8_pos/test_evaluation"

# Model config (matching training)
CONCEPT_DIM=256
MIX_DEPTH=3
MIX_HEADS=4
MIX_MLP_RATIO=4.0
DROPOUT=0.3
XATTN_HEADS=8
XATTN_TEMPERATURE=2.5
XATTN_TOPK=16
MAX_PATCHES=576

echo "============================================================"
echo "Evaluating Cross-Attention Model on Test Set"
echo "============================================================"
echo "Checkpoint: $CHECKPOINT"
echo "Test CSV: $TEST_CSV"
echo "Output: $OUTPUT_DIR"
echo "============================================================"

mkdir -p "$OUTPUT_DIR"

python -m cbm.phase1.eval \
  --checkpoint "$CHECKPOINT" \
  --test-csv "$TEST_CSV" \
  --cached-dir "$CACHED_DIR" \
  --concept-data-dir "$CONCEPT_DATA" \
  --output-dir "$OUTPUT_DIR" \
  --head-type cross_attention \
  --concept-dim "$CONCEPT_DIM" \
  --dropout "$DROPOUT" \
  --mix-depth "$MIX_DEPTH" \
  --mix-heads "$MIX_HEADS" \
  --mix-mlp-ratio "$MIX_MLP_RATIO" \
  --xattn-heads "$XATTN_HEADS" \
  --xattn-temperature "$XATTN_TEMPERATURE" \
  --xattn-topk "$XATTN_TOPK" \
  --use-pos-encoding \
  --max-patches "$MAX_PATCHES" \
  --batch-size 64 \
  --num-workers 4 \
  --generate-visualizations \
  --num-viz-samples 20 \
  --device cuda

echo "============================================================"
echo "Evaluation complete!"
echo "Results saved to: $OUTPUT_DIR"
echo "============================================================"

