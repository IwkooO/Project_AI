#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=phase1_2_adaptive
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=4:00:00
#SBATCH --output=jobs/outputs/phase1_2_adaptive_%j.out

set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"

# Activate environment
export GEOTIFF_CSV="${GEOTIFF_CSV:-}"
set +u
source activate streetview
set -u

wandb_api_key="9073a011764cb23fce5384443a3996ca9c5d9198"
export WANDB_API_KEY="$wandb_api_key"

# ============================================================
# PHASE 1 CONFIG (Adaptive Tau, TextInit-heavy)
# ============================================================
TAU=0.25
TOPK=6
STK_MASK_PROB=0.45
MIX_LOCAL_KERNEL=5
CONCEPT_DIM=768
PROJ_TYPE=simple
USE_PER_CONCEPT_TAU=true
DROPOUT=0.45
WEIGHT_DECAY=0.1

RUN_TAG="tau${TAU}_k${TOPK}_stk${STK_MASK_PROB}_lk${MIX_LOCAL_KERNEL}_cdim${CONCEPT_DIM}_adaptivetau_concept_only"
PHASE1_CHECKPOINT="checkpoints/phase1_textinit_adaptive/reg-cbm_stage_1_textinit_visinit_interpretable_tau0.25_k6_stk0.45_lk5_cdim768_adaptivetau/phase1/best_phase1.pt"

# Paths
SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"
CONCEPT_MAPPING="data/concept_refinement_mapped.csv"

# Use original splits (they should work fine for Stage 2)
TRAIN_CSV="${SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${SPLITS_DIR}/dataset_val.csv"
TEST_CSV="${SPLITS_DIR}/dataset_test.csv"


PHASE1_BASE_DIR="checkpoints/phase1_textinit_adaptive/reg-cbm_stage_1_textinit_visinit_interpretable_tau0.25_k6_stk0.45_lk5_cdim768_adaptivetau"

# Find the most recent run directory with concept_data_v2
# Sort by modification time (most recent first) and check for required files
PHASE1_CONCEPT_DATA=""
for dir in $(find "$PHASE1_BASE_DIR" -type d -name "concept_data_v2" -path "*/run_*/concept_data_v2" 2>/dev/null | sort -r); do
  if [[ -f "$dir/concept_vocab.json" ]] && [[ -f "$dir/s2_cells.json" ]]; then
    PHASE1_CONCEPT_DATA="$dir"
    break
  fi
done

if [[ -z "$PHASE1_CONCEPT_DATA" ]] || [[ ! -d "$PHASE1_CONCEPT_DATA" ]]; then
  echo "ERROR: Could not find concept_data_v2 directory with required files in $PHASE1_BASE_DIR"
  echo "Looking for: $PHASE1_BASE_DIR/run_*/concept_data_v2/concept_vocab.json"
  echo "Available directories:"
  find "$PHASE1_BASE_DIR" -type d -name "concept_data_v2" 2>/dev/null | head -n 5
  exit 1
fi

echo "Using concept_data_dir: $PHASE1_CONCEPT_DATA"

echo "============================================================"
echo "STEP 2: STAGE 2 TRAINING (CONCEPT ONLY)"
echo "============================================================"

STAGE2_DIR_IMG="checkpoints/stage2_textinit_heavy/stage2_adaptivetau_conc_only_${RUN_TAG}"
mkdir -p "$STAGE2_DIR_IMG"

python -m cbm.phase2.train \
  --train-csv "$TRAIN_CSV" \
  --val-csv "$VAL_CSV" \
  --test-csv "$TEST_CSV" \
  --cached-dir "$CACHED_DIR" \
  --phase1-checkpoint "$PHASE1_CHECKPOINT" \
  --concept-data-dir "$PHASE1_CONCEPT_DATA" \
  --output-dir "$STAGE2_DIR_IMG" \
  --num-cells 1000 \
  --hidden-dim 512 \
  --num-heads 8 \
  --num-layers 2 \
  --dropout 0.1 \
  --mode concept_only \
  --batch-size 128 \
  --epochs 100 \
  --lr 1e-4 \
  --weight-decay 0.01 \
  --cell-loss-weight 1.0 \
  --offset-loss-weight 10.0 \
  --concept-dim "$CONCEPT_DIM" \
  --patch-dim 1024 \
  --phase1-dropout "$DROPOUT" \
  --phase1-mil-topk "$TOPK" \
  --phase1-mil-tau "$TAU" \
  --phase1-mix-depth 1 \
  --phase1-mix-heads 4 \
  --phase1-mix-mlp-ratio 2.0 \
  --phase1-mix-local-kernel-size "$MIX_LOCAL_KERNEL" \
  --phase1-proj-type "$PROJ_TYPE" \
  --phase1-use-per-concept-tau \
  --wandb \
  --wandb-project "cbm_stage2" \
  --wandb-run-name "stage2_concept_only_adaptivetau_${RUN_TAG}" \
  --early-stop-patience 10
