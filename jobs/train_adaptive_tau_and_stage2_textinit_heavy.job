#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=phase1_2_adaptive
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=36:00:00
#SBATCH --output=jobs/outputs/phase1_2_adaptive_%j.out

set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"

# Activate environment
export GEOTIFF_CSV="${GEOTIFF_CSV:-}"
set +u
source activate streetview
set -u

wandb_api_key="9073a011764cb23fce5384443a3996ca9c5d9198"
export WANDB_API_KEY="$wandb_api_key"

# ============================================================
# PHASE 1 CONFIG (Adaptive Tau, TextInit-heavy)
# ============================================================
TAU=0.25
TOPK=6
STK_MASK_PROB=0.45
MIX_LOCAL_KERNEL=5
CONCEPT_DIM=768
PROJ_TYPE=simple
USE_PER_CONCEPT_TAU=true
DROPOUT=0.45
WEIGHT_DECAY=0.1

RUN_TAG="tau${TAU}_k${TOPK}_stk${STK_MASK_PROB}_lk${MIX_LOCAL_KERNEL}_cdim${CONCEPT_DIM}_adaptivetau"
PHASE1_OUTPUT_DIR="checkpoints/phase1_textinit_adaptive/reg-cbm_stage_1_textinit_visinit_interpretable_${RUN_TAG}"

# Paths
SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"
CONCEPT_MAPPING="data/concept_refinement_mapped.csv"

# Per-job working directory for Phase 1
RUN_ID="${SLURM_JOB_ID:-local_$(date +%Y%m%d_%H%M%S)}"
PHASE1_WORKDIR="${PHASE1_OUTPUT_DIR}/run_${RUN_ID}"
PHASE1_SPLITS_DIR="${PHASE1_WORKDIR}/splits"
PHASE1_CONCEPT_DATA="${PHASE1_WORKDIR}/concept_data_v2"

mkdir -p "$PHASE1_OUTPUT_DIR" "$PHASE1_SPLITS_DIR" "$PHASE1_CONCEPT_DATA"

# Copy splits
for split in train val test; do
  src="${SPLITS_DIR}/dataset_${split}.csv"
  if [[ -f "${src}.bak" ]]; then
    cp "${src}.bak" "${PHASE1_SPLITS_DIR}/dataset_${split}.csv"
  else
    cp "${src}" "${PHASE1_SPLITS_DIR}/dataset_${split}.csv"
  fi
done

TRAIN_CSV="${PHASE1_SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${PHASE1_SPLITS_DIR}/dataset_val.csv"
TEST_CSV="${PHASE1_SPLITS_DIR}/dataset_test.csv"

echo "============================================================"
echo "STEP 1: PHASE 1 TRAINING (Adaptive Tau)"
echo "============================================================"

# Pre-processing
python scripts/data_processing/map_generalized_concepts.py \
  --splits-dir "$PHASE1_SPLITS_DIR" \
  --mapping "$CONCEPT_MAPPING"

python scripts/data_processing/precompute_geo_priors.py \
  --train-csv "$TRAIN_CSV" \
  --output-dir "$PHASE1_CONCEPT_DATA" \
  --s2-level 8

# Train Phase 1
python -m cbm.phase1.train \
  --train-csv "$TRAIN_CSV" \
  --val-csv "$VAL_CSV" \
  --cached-dir "$CACHED_DIR" \
  --concept-data-dir "$PHASE1_CONCEPT_DATA" \
  --output-dir "$PHASE1_OUTPUT_DIR" \
  --epochs 80 \
  --batch-size 64 \
  --lr 7e-5 \
  --warmup-epochs 5 \
  --wandb \
  --wandb-run-name "phase1_adaptivetau_${RUN_TAG}" \
  --init-concepts-from-text \
  --concept-dim "$CONCEPT_DIM" \
  --attn-tau "$TAU" \
  --mil-topk "$TOPK" \
  --mix-depth 1 --mix-heads 4 --mix-mlp-ratio 2.0 \
  --mix-local-kernel-size "$MIX_LOCAL_KERNEL" \
  --dropout "$DROPOUT" --weight-decay "$WEIGHT_DECAY" \
  --selection-metric acc1 \
  --stk-mask-prob "$STK_MASK_PROB" \
  --stk-k-mask 1 \
  --stk-mask-fill min \
  --use-per-concept-tau \
  --early-stop-patience 10

PHASE1_CHECKPOINT="${PHASE1_OUTPUT_DIR}/phase1/best_phase1.pt"

if [[ ! -f "$PHASE1_CHECKPOINT" ]]; then
  echo "ERROR: Phase 1 failed to produce best_phase1.pt"
  exit 1
fi

echo "============================================================"
echo "STEP 1B: PHASE 1 EVALUATION (Test Set)"
echo "============================================================"

PHASE1_EVAL_OUTPUT_DIR="${PHASE1_OUTPUT_DIR}/test_evaluation"
mkdir -p "$PHASE1_EVAL_OUTPUT_DIR"

python -m cbm.phase1.eval \
  --checkpoint "$PHASE1_CHECKPOINT" \
  --test-csv "$TEST_CSV" \
  --cached-dir "$CACHED_DIR" \
  --concept-data-dir "$PHASE1_CONCEPT_DATA" \
  --output-dir "$PHASE1_EVAL_OUTPUT_DIR" \
  --head-type topk_mil \
  --concept-dim "$CONCEPT_DIM" \
  --dropout "$DROPOUT" \
  --mil-topk "$TOPK" \
  --mil-tau "$TAU" \
  --mix-depth 1 \
  --mix-heads 4 \
  --mix-mlp-ratio 2.0 \
  --mix-local-kernel-size "$MIX_LOCAL_KERNEL" \
  --proj-type "$PROJ_TYPE" \
  --batch-size 64 \
  --num-workers 4 \
  --max-patches 576 \
  --use-pos-encoding \
  --use-per-concept-tau \
  --generate-visualizations \
  --num-viz-samples 20 \
  --device cuda

echo "============================================================"
echo "STEP 2: STAGE 2 TRAINING (IMAGE ONLY)"
echo "============================================================"

STAGE2_DIR_IMG="checkpoints/stage2_textinit_heavy/stage2_adaptivetau_image_only_${RUN_TAG}"
mkdir -p "$STAGE2_DIR_IMG"

python -m cbm.phase2.train \
  --train-csv "$TRAIN_CSV" \
  --val-csv "$VAL_CSV" \
  --test-csv "$TEST_CSV" \
  --cached-dir "$CACHED_DIR" \
  --phase1-checkpoint "$PHASE1_CHECKPOINT" \
  --concept-data-dir "$PHASE1_CONCEPT_DATA" \
  --output-dir "$STAGE2_DIR_IMG" \
  --num-cells 1000 \
  --hidden-dim 512 \
  --num-heads 8 \
  --num-layers 2 \
  --dropout 0.1 \
  --mode image_only \
  --batch-size 128 \
  --epochs 100 \
  --lr 1e-4 \
  --weight-decay 0.01 \
  --cell-loss-weight 1.0 \
  --offset-loss-weight 10.0 \
  --concept-dim "$CONCEPT_DIM" \
  --patch-dim 1024 \
  --phase1-dropout "$DROPOUT" \
  --phase1-mil-topk "$TOPK" \
  --phase1-mil-tau "$TAU" \
  --phase1-mix-depth 1 \
  --phase1-mix-heads 4 \
  --phase1-mix-mlp-ratio 2.0 \
  --phase1-mix-local-kernel-size "$MIX_LOCAL_KERNEL" \
  --phase1-proj-type "$PROJ_TYPE" \
  --phase1-use-per-concept-tau \
  --wandb \
  --wandb-project "cbm_stage2" \
  --wandb-run-name "stage2_image_only_adaptivetau_${RUN_TAG}" \
  --early-stop-patience 10

echo "============================================================"
echo "STEP 3: STAGE 2 TRAINING (BOTH)"
echo "============================================================"

STAGE2_DIR_BOTH="checkpoints/stage2_textinit_heavy/stage2_adaptivetau_both_${RUN_TAG}"
mkdir -p "$STAGE2_DIR_BOTH"

python -m cbm.phase2.train \
  --train-csv "$TRAIN_CSV" \
  --val-csv "$VAL_CSV" \
  --test-csv "$TEST_CSV" \
  --cached-dir "$CACHED_DIR" \
  --phase1-checkpoint "$PHASE1_CHECKPOINT" \
  --concept-data-dir "$PHASE1_CONCEPT_DATA" \
  --output-dir "$STAGE2_DIR_BOTH" \
  --num-cells 1000 \
  --hidden-dim 512 \
  --num-heads 8 \
  --num-layers 2 \
  --dropout 0.1 \
  --mode both \
  --batch-size 128 \
  --epochs 100 \
  --lr 1e-4 \
  --weight-decay 0.01 \
  --cell-loss-weight 1.0 \
  --offset-loss-weight 10.0 \
  --orthogonality-weight 0.0 \
  --balance-weight 0.05 \
  --concept-dim "$CONCEPT_DIM" \
  --patch-dim 1024 \
  --phase1-dropout "$DROPOUT" \
  --phase1-mil-topk "$TOPK" \
  --phase1-mil-tau "$TAU" \
  --phase1-mix-depth 1 \
  --phase1-mix-heads 4 \
  --phase1-mix-mlp-ratio 2.0 \
  --phase1-mix-local-kernel-size "$MIX_LOCAL_KERNEL" \
  --phase1-proj-type "$PROJ_TYPE" \
  --phase1-use-per-concept-tau \
  --wandb \
  --wandb-project "cbm_stage2" \
  --wandb-run-name "stage2_both_adaptivetau_${RUN_TAG}" \
  --early-stop-patience 10

echo "============================================================"
echo "ALL STEPS COMPLETE!"
echo "============================================================"

