#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=retrain_phase1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=18:00:00
#SBATCH --output=jobs/outputs/retrain_phase1_%j.out

set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"
mkdir -p jobs/outputs

source activate streetview

wandb_api_key="9073a011764cb23fce5384443a3996ca9c5d9198"
export WANDB_API_KEY="$wandb_api_key"

# ============================================================
# PHASE 1 CONFIG (EXACT from WandB)
# ============================================================
MIX_DEPTH=1
MIX_HEADS=4
MIX_MLP_RATIO=2.0
CONCEPT_DIM=256
TAU=0.25
TOPK=6
STK_MASK_PROB=0.4
STK_K_MASK=1
MIX_LOCAL_KERNEL=0          # From WandB: 0 (not 5!)
PROJ_TYPE=simple
DROPOUT=0.3                 # From WandB: 0.3 (not 0.45!)
WEIGHT_DECAY=0.05           # From WandB: 0.05 (not 0.1!)
USE_POS_ENCODING=true
MAX_PATCHES=576
USE_PER_CONCEPT_TAU=true

RUN_TAG="adaptive_tau_d${MIX_DEPTH}_h${MIX_HEADS}_dim${CONCEPT_DIM}_pos"
OUTPUT_DIR="checkpoints/phase1_adaptive_tau/${RUN_TAG}"

# Paths
SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"
CONCEPT_MAPPING="data/concept_refinement_mapped.csv"

# Per-job working directory
RUN_ID="${SLURM_JOB_ID:-local_$(date +%Y%m%d_%H%M%S)}"
RUN_WORKDIR="${OUTPUT_DIR}/run_${RUN_ID}"
RUN_SPLITS_DIR="${RUN_WORKDIR}/splits"
RUN_CONCEPT_DATA="${RUN_WORKDIR}/concept_data_v2"

mkdir -p "$OUTPUT_DIR" "$RUN_SPLITS_DIR" "$RUN_CONCEPT_DATA"

# Copy splits
for split in train val test; do
  src="${SPLITS_DIR}/dataset_${split}.csv"
  if [[ -f "${src}.bak" ]]; then
    cp "${src}.bak" "${RUN_SPLITS_DIR}/dataset_${split}.csv"
  else
    cp "$src" "${RUN_SPLITS_DIR}/dataset_${split}.csv"
  fi
done

TRAIN_CSV="${RUN_SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${RUN_SPLITS_DIR}/dataset_val.csv"
CONCEPT_DATA="$RUN_CONCEPT_DATA"

echo "============================================================"
echo "RETRAINING PHASE 1: Adaptive Tau (EXACT WandB Config)"
echo "============================================================"

# Step 1: Map concepts
python scripts/data_processing/map_generalized_concepts.py \
  --splits-dir "$RUN_SPLITS_DIR" \
  --mapping "$CONCEPT_MAPPING"

# Step 2: Precompute geo priors
python scripts/data_processing/precompute_geo_priors.py \
  --train-csv "$TRAIN_CSV" \
  --output-dir "$CONCEPT_DATA" \
  --s2-level 8

# Step 3: Train Phase 1 (EXACT parameters from WandB)
python -m cbm.phase1.train \
  --train-csv "$TRAIN_CSV" \
  --val-csv "$VAL_CSV" \
  --cached-dir "$CACHED_DIR" \
  --concept-data-dir "$CONCEPT_DATA" \
  --output-dir "$OUTPUT_DIR" \
  --epochs 100 \
  --batch-size 64 \
  --lr 5e-5 \
  --warmup-epochs 8 \
  --wandb \
  --wandb-run-name "adaptive_tau_d1_h4_dim256_pos" \
  --head-type topk_mil \
  --concept-dim 256 \
  --attn-tau 0.25 \
  --mil-topk 6 \
  --mix-depth 1 \
  --mix-heads 4 \
  --mix-mlp-ratio 2.0 \
  --mix-local-kernel-size 0 \
  --dropout 0.3 \
  --weight-decay 0.05 \
  --selection-metric acc1 \
  --stk-mask-prob 0.4 \
  --stk-k-mask 1 \
  --proj-type simple \
  --attn-diversity-weight 0.0 \
  --early-stop-patience 10 \
  --max-patches 576 \
  --use-pos-encoding \
  --use-per-concept-tau

echo "============================================================"
echo "Phase 1 training complete!"
echo "Checkpoint: ${OUTPUT_DIR}/phase1/best_phase1.pt"
echo "Concept data: $CONCEPT_DATA"
echo "Splits: $RUN_SPLITS_DIR"
echo "============================================================"
EOF

chmod +x jobs/retrain_phase1_adaptive_tau.job