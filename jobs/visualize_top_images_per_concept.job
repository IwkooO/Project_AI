#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=top_images_concept
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=4:00:00
#SBATCH --output=jobs/outputs/visualize_top_images_per_concept_%j.out

set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"

mkdir -p jobs/outputs

echo "============================================================"
echo "Activating project venv"
echo "============================================================"

# Activate environment
export GEOTIFF_CSV="${GEOTIFF_CSV:-}"
set +u
source activate streetview
set -u

# ============================================================
# TOP IMAGES PER CONCEPT CONFIG
# ============================================================

# Checkpoint directory (relative to project root)
CHECKPOINT_BOTH="/home/igodzwon/Project_AI/checkpoints/stage3_joint_latefusion/stage3_joint_both_scratchgeo_dim256_pos_latefusion_2.5ct_gatereg_0.01_drop0.3"

# Data paths
# Find Phase 1 run directory to get correct splits and concept data
PHASE1_BASE_DIR="checkpoints/phase1_adaptive_tau/adaptive_tau_d1_h4_dim256_pos"
PHASE1_RUN_DIR=$(find "$PHASE1_BASE_DIR" -type d -name "run_*" | sort -r | while read run_dir; do
  if [[ -d "$run_dir/concept_data_v2" ]] && [[ -f "$run_dir/concept_data_v2/concept_vocab.json" ]]; then
    echo "$run_dir"
    break
  fi
done | head -n 1)

if [[ -z "$PHASE1_RUN_DIR" ]]; then
  echo "WARNING: Could not find Phase 1 run directory, using default paths"
  SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
  CONCEPT_DATA_DIR="data/concept_data_v2"
else
  SPLITS_DIR="${PHASE1_RUN_DIR}/splits"
  CONCEPT_DATA_DIR="${PHASE1_RUN_DIR}/concept_data_v2"
fi

TEST_CSV="${SPLITS_DIR}/dataset_test.csv"
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"

# Image directory (optional, if images are available)
IMAGE_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/panorama_processed"

# Output directory
OUTPUT_DIR="results/top_images_per_concept"

mkdir -p "$OUTPUT_DIR"
mkdir -p jobs/outputs

echo "============================================================"
echo "TOP IMAGES PER CONCEPT VISUALIZATION"
echo "============================================================"
echo "Checkpoint (Both): $CHECKPOINT_BOTH"
echo "Test CSV: $TEST_CSV"
echo "Concept Data: $CONCEPT_DATA_DIR"
echo "Image Dir: $IMAGE_DIR"
echo "Output: $OUTPUT_DIR"
echo "============================================================"

# Verify checkpoint exists
if [[ ! -d "$CHECKPOINT_BOTH" ]]; then
  echo "ERROR: Checkpoint directory not found: $CHECKPOINT_BOTH"
  exit 1
fi
if [[ ! -f "$CHECKPOINT_BOTH/best_joint.pt" ]] && [[ ! -f "$CHECKPOINT_BOTH/phase1/best_phase1.pt" ]]; then
  echo "WARNING: No checkpoint file found in $CHECKPOINT_BOTH"
fi

# Verify test CSV exists
if [[ ! -f "$TEST_CSV" ]]; then
  echo "ERROR: Test CSV not found at $TEST_CSV"
  exit 1
fi

# Verify concept data exists
if [[ ! -f "$CONCEPT_DATA_DIR/concept_vocab.json" ]]; then
  echo "ERROR: Concept vocabulary not found at $CONCEPT_DATA_DIR/concept_vocab.json"
  exit 1
fi

# Run visualization
python scripts/evaluation/visualize_top_images_per_concept.py \
  --checkpoint-both "$CHECKPOINT_BOTH" \
  --test-csv "$TEST_CSV" \
  --concept-data-dir "$CONCEPT_DATA_DIR" \
  --cached-dir "$CACHED_DIR" \
  --image-dir "$IMAGE_DIR" \
  --output-dir "$OUTPUT_DIR" \
  --concept-dim 256 \
  --hidden-dim 512 \
  --num-heads 8 \
  --num-layers 2 \
  --dropout 0.1 \
  --phase1-dropout 0.45 \
  --mil-topk 6 \
  --mil-tau 0.25 \
  --mix-depth 1 \
  --mix-heads 4 \
  --mix-mlp-ratio 2.0 \
  --mix-local-kernel 0 \
  --proj-type simple \
  --concept-temperature 2.5 \
  --batch-size 64 \
  --num-workers 4 \
  --device cuda \
  --num-concepts 20 \
  --num-images-per-concept 10 \
  --min-samples 10

echo "============================================================"
echo "Visualization complete!"
echo "Results saved to: $OUTPUT_DIR"
echo "============================================================"
echo "Generated files:"
echo "  - concept_XXXX_conceptname.png (one per concept)"
echo "  - Each file shows top 10 images with attention overlays"
echo "============================================================"

