#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=cbm_xattn
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=24:00:00
#SBATCH --output=jobs/outputs/cbm_cross_attention_%j.out

set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"
mkdir -p jobs/outputs

echo "============================================================"
echo "Activating environment"
echo "============================================================"

# Activate environment
export GEOTIFF_CSV="${GEOTIFF_CSV:-}"
set +u
source activate streetview
set -u

wandb_api_key="9073a011764cb23fce5384443a3996ca9c5d9198"
export WANDB_API_KEY="$wandb_api_key"

# Paths
SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
TRAIN_CSV="${SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${SPLITS_DIR}/dataset_val.csv"

# Cached embeddings (must already exist)
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"

# Concept vocab/priors
CONCEPT_DATA="data/concept_data_v2"

# Cross-attention hyperparameters
CONCEPT_DIM="${CONCEPT_DIM:-256}"
MIX_DEPTH="${MIX_DEPTH:-3}"        # Deeper: 3 layers instead of 1
XATTN_HEADS="${XATTN_HEADS:-8}"
XATTN_TEMP="${XATTN_TEMP:-1.0}"
XATTN_TOPK="${XATTN_TOPK:-16}"     # Top-16 patches for sparse attention (0 = full attention)

# Regularization
DROPOUT="${DROPOUT:-0.3}"
WEIGHT_DECAY="${WEIGHT_DECAY:-0.05}"
EARLY_STOP_PATIENCE="${EARLY_STOP_PATIENCE:-15}"  # Patience for cross-attention (may need more epochs)

# Training
LR="${LR:-5e-5}"                   # Slightly lower LR for deeper model
EPOCHS="${EPOCHS:-100}"
BATCH_SIZE="${BATCH_SIZE:-64}"
WARMUP_EPOCHS="${WARMUP_EPOCHS:-10}"

# Wandb run name
WANDB_RUN_NAME="${WANDB_RUN_NAME:-xattn_d${MIX_DEPTH}_h${XATTN_HEADS}_k${XATTN_TOPK}}"

RUN_TAG="xattn_d${MIX_DEPTH}_h${XATTN_HEADS}_k${XATTN_TOPK}_dim${CONCEPT_DIM}"
OUTPUT_DIR="${OUTPUT_DIR:-checkpoints/phase1_cross_attention/${RUN_TAG}}"
CONCEPT_MAPPING="data/concept_refinement_mapped.csv"

# --------------------------------------------------------------------------------------
# Per-job working directory to avoid race conditions in sweeps
# --------------------------------------------------------------------------------------
RUN_ID="${SLURM_JOB_ID:-local_$(date +%Y%m%d_%H%M%S)}"
RUN_WORKDIR="${OUTPUT_DIR}/run_${RUN_ID}"
RUN_SPLITS_DIR="${RUN_WORKDIR}/splits"
RUN_CONCEPT_DATA="${RUN_WORKDIR}/concept_data_v2"

mkdir -p "$OUTPUT_DIR" "$RUN_SPLITS_DIR" "$RUN_CONCEPT_DATA"

# Copy split CSVs
for split in train val test; do
  src="${SPLITS_DIR}/dataset_${split}.csv"
  if [[ -f "${src}.bak" ]]; then
    cp "${src}.bak" "${RUN_SPLITS_DIR}/dataset_${split}.csv"
  else
    cp "${src}" "${RUN_SPLITS_DIR}/dataset_${split}.csv"
  fi
done

SPLITS_DIR="$RUN_SPLITS_DIR"
TRAIN_CSV="${SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${SPLITS_DIR}/dataset_val.csv"
CONCEPT_DATA="$RUN_CONCEPT_DATA"

echo "============================================================"
echo "Step 0: Mapping meta_name -> generalized concepts"
echo "============================================================"
python scripts/data_processing/map_generalized_concepts.py \
  --splits-dir "$SPLITS_DIR" \
  --mapping "$CONCEPT_MAPPING"

echo "============================================================"
echo "Step 1: Precomputing concept vocab + geo priors"
echo "============================================================"
python scripts/data_processing/precompute_geo_priors.py \
  --train-csv "$TRAIN_CSV" \
  --output-dir "$CONCEPT_DATA" \
  --s2-level 8

echo "============================================================"
echo "Step 2: Ensure cached StreetCLIP embeddings exist"
echo "============================================================"
if [[ ! -f "$CACHED_DIR/train_pooled_embeddings.pt" || ! -f "$CACHED_DIR/train_metadata.json" || ! -f "$CACHED_DIR/train_patch_tokens.pt" ]]; then
  echo "ERROR: Missing cached embeddings in $CACHED_DIR"
  echo "Run scripts/data_processing/precompute_streetclip_embeddings.py first."
  exit 1
fi

echo "============================================================"
echo "Step 3: Train Phase 1 with Cross-Attention Concept Head"
echo "  - head_type: cross_attention"
echo "  - concept_dim: $CONCEPT_DIM"
echo "  - mix_depth: $MIX_DEPTH (deeper patch mixer)"
echo "  - xattn_heads: $XATTN_HEADS"
echo "  - xattn_topk: $XATTN_TOPK"
echo "  - xattn_temperature: $XATTN_TEMP"
echo "============================================================"
python -m cbm.phase1.train \
  --train-csv "$TRAIN_CSV" \
  --val-csv "$VAL_CSV" \
  --cached-dir "$CACHED_DIR" \
  --concept-data-dir "$CONCEPT_DATA" \
  --output-dir "$OUTPUT_DIR" \
  --epochs "$EPOCHS" \
  --batch-size "$BATCH_SIZE" \
  --lr "$LR" \
  --warmup-epochs "$WARMUP_EPOCHS" \
  --wandb \
  --wandb-run-name "$WANDB_RUN_NAME" \
  --head-type cross_attention \
  --concept-dim "$CONCEPT_DIM" \
  --mix-depth "$MIX_DEPTH" \
  --mix-mlp-ratio 4.0 \
  --xattn-heads "$XATTN_HEADS" \
  --xattn-temperature "$XATTN_TEMP" \
  --xattn-topk "$XATTN_TOPK" \
  --dropout "$DROPOUT" \
  --weight-decay "$WEIGHT_DECAY" \
  --selection-metric acc1 \
  --early-stop-patience "$EARLY_STOP_PATIENCE"

echo "============================================================"
echo "Training complete! (Cross-Attention Concept Head)"
echo "Outputs: $OUTPUT_DIR"
echo "============================================================"

# Evaluate on test set
BEST_CHECKPOINT="${OUTPUT_DIR}/phase1/best_phase1.pt"
TEST_CSV="${SPLITS_DIR}/dataset_test.csv"
EVAL_OUTPUT_DIR="${OUTPUT_DIR}/test_evaluation"

if [[ ! -f "$BEST_CHECKPOINT" ]]; then
  echo "WARNING: Best checkpoint not found at $BEST_CHECKPOINT"
  echo "Skipping test set evaluation."
  exit 0
fi

if [[ ! -f "$TEST_CSV" ]]; then
  echo "WARNING: Test CSV not found at $TEST_CSV"
  echo "Skipping test set evaluation."
  exit 0
fi

echo "============================================================"
echo "Step 4: Evaluating on Test Set with Visualizations"
echo "============================================================"
echo "Checkpoint: $BEST_CHECKPOINT"
echo "Test CSV: $TEST_CSV"
echo "Output: $EVAL_OUTPUT_DIR"
echo "============================================================"

mkdir -p "$EVAL_OUTPUT_DIR"

python -m cbm.phase1.eval \
  --checkpoint "$BEST_CHECKPOINT" \
  --test-csv "$TEST_CSV" \
  --cached-dir "$CACHED_DIR" \
  --concept-data-dir "$CONCEPT_DATA" \
  --output-dir "$EVAL_OUTPUT_DIR" \
  --head-type cross_attention \
  --concept-dim "$CONCEPT_DIM" \
  --mix-depth "$MIX_DEPTH" \
  --mix-mlp-ratio 4.0 \
  --xattn-heads "$XATTN_HEADS" \
  --xattn-temperature "$XATTN_TEMP" \
  --xattn-topk "$XATTN_TOPK" \
  --dropout "$DROPOUT" \
  --batch-size "$BATCH_SIZE" \
  --num-workers 4 \
  --generate-visualizations \
  --num-viz-samples 20 \
  --device cuda

echo "============================================================"
echo "Test evaluation complete!"
echo "Results saved to: $EVAL_OUTPUT_DIR"
echo "Metrics: $EVAL_OUTPUT_DIR/metrics.json"
echo "Visualizations: $EVAL_OUTPUT_DIR/visualizations/"
echo "============================================================"

