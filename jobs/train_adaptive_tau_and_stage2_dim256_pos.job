#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=phase1_2_adaptive_dim256
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=4:00:00
#SBATCH --output=jobs/outputs/phase1_2_adaptive_dim256_%j.out

set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"

# Activate environment
export GEOTIFF_CSV="${GEOTIFF_CSV:-}"
set +u
source activate streetview
set -u

wandb_api_key="9073a011764cb23fce5384443a3996ca9c5d9198"
export WANDB_API_KEY="$wandb_api_key"

# ============================================================
# PHASE 1 CONFIG (Adaptive Tau, Dim256, Positional Encoding)
# ============================================================
TAU=0.25
TOPK=6
MIX_LOCAL_KERNEL=0
CONCEPT_DIM=256
MIX_HEADS=4
MIX_DEPTH=1
PROJ_TYPE=simple
USE_PER_CONCEPT_TAU=true
DROPOUT=0.45
WEIGHT_DECAY=0.1

RUN_TAG="adaptive_tau_d1_h4_dim256_pos_both"
PHASE1_BASE_DIR="checkpoints/phase1_adaptive_tau/adaptive_tau_d1_h4_dim256_pos"
PHASE1_CHECKPOINT="${PHASE1_BASE_DIR}/phase1/best_phase1.pt"

# Paths
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"
CONCEPT_MAPPING="data/concept_refinement_mapped.csv"

# Use splits from Phase 1 run (these match the concept vocabulary)
# Find the most recent run directory with splits
PHASE1_SPLITS_DIR=""
for run_dir in $(find "$PHASE1_BASE_DIR" -type d -name "run_*" -path "*/run_*/splits" 2>/dev/null | xargs dirname | sort -r); do
    splits_dir="${run_dir}/splits"
    if [[ -d "$splits_dir" ]] && [[ -f "${splits_dir}/dataset_train.csv" ]]; then
        PHASE1_SPLITS_DIR="$splits_dir"
        break
    fi
done

# Fallback to specific run if available
if [[ -z "$PHASE1_SPLITS_DIR" ]] && [[ -d "${PHASE1_BASE_DIR}/run_17929069/splits" ]]; then
    PHASE1_SPLITS_DIR="${PHASE1_BASE_DIR}/run_17929069/splits"
fi

# Final fallback to default splits
if [[ -z "$PHASE1_SPLITS_DIR" ]] || [[ ! -d "$PHASE1_SPLITS_DIR" ]]; then
    echo "WARNING: Could not find Phase 1 splits, using default splits"
    echo "This may cause concept vocabulary mismatches!"
    PHASE1_SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
else
    echo "Using Phase 1 splits from: $PHASE1_SPLITS_DIR"
fi

TRAIN_CSV="${PHASE1_SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${PHASE1_SPLITS_DIR}/dataset_val.csv"
TEST_CSV="${PHASE1_SPLITS_DIR}/dataset_test.csv"

# Find the concept_data_v2 directory
# Check if it's directly in the base directory first
PHASE1_CONCEPT_DATA=""
if [[ -d "${PHASE1_BASE_DIR}/concept_data_v2" ]]; then
    PHASE1_CONCEPT_DATA="${PHASE1_BASE_DIR}/concept_data_v2"
else
    # Try to find it in a subdirectory if created by a sweep
    PHASE1_CONCEPT_DATA=$(find "$PHASE1_BASE_DIR" -type d -name "concept_data_v2" | head -n 1)
fi

if [[ -z "$PHASE1_CONCEPT_DATA" ]] || [[ ! -d "$PHASE1_CONCEPT_DATA" ]]; then
    echo "ERROR: Could not find concept_data_v2 directory in $PHASE1_BASE_DIR"
    echo "Looking for: $PHASE1_BASE_DIR/concept_data_v2 or $PHASE1_BASE_DIR/run_*/concept_data_v2"
    echo "Available directories:"
    find "$PHASE1_BASE_DIR" -type d -name "concept_data_v2" 2>/dev/null | head -n 5
    exit 1
fi

# Verify required files exist
CONCEPT_VOCAB="${PHASE1_CONCEPT_DATA}/concept_vocab.json"
if [[ ! -f "$CONCEPT_VOCAB" ]]; then
    echo "ERROR: Concept vocabulary not found: $CONCEPT_VOCAB"
    exit 1
fi

echo "Using concept_data_dir: $PHASE1_CONCEPT_DATA"
echo "Using concept vocabulary: $CONCEPT_VOCAB"

# Verify CSV files exist
for csv_file in "$TRAIN_CSV" "$VAL_CSV"; do
    if [[ ! -f "$csv_file" ]]; then
        echo "ERROR: CSV file not found: $csv_file"
        exit 1
    fi
done

echo "============================================================"
echo "STEP 2: STAGE 2 TRAINING (CONCEPT ONLY)"
echo "============================================================"
echo "Phase 1 Checkpoint: $PHASE1_CHECKPOINT"
echo "Concept Dim: $CONCEPT_DIM"
echo "Mix Heads: $MIX_HEADS"
echo "Mix Depth: $MIX_DEPTH"
echo "Mix Local Kernel: $MIX_LOCAL_KERNEL"
echo "Positional Encoding: YES"
echo "============================================================"

STAGE2_DIR_IMG="checkpoints/stage2_adaptive_tau/stage2_adaptivetau_image_only_${RUN_TAG}"
mkdir -p "$STAGE2_DIR_IMG"

python -m cbm.phase2.train \
  --train-csv "$TRAIN_CSV" \
  --val-csv "$VAL_CSV" \
  --test-csv "$TEST_CSV" \
  --cached-dir "$CACHED_DIR" \
  --phase1-checkpoint "$PHASE1_CHECKPOINT" \
  --concept-data-dir "$PHASE1_CONCEPT_DATA" \
  --output-dir "$STAGE2_DIR_IMG" \
  --num-cells 1000 \
  --hidden-dim 512 \
  --num-heads 8 \
  --num-layers 2 \
  --dropout 0.1 \
  --mode image_only \
  --batch-size 128 \
  --epochs 100 \
  --lr 1e-4 \
  --weight-decay 0.01 \
  --cell-loss-weight 1.0 \
  --offset-loss-weight 10.0 \
  --concept-dim "$CONCEPT_DIM" \
  --patch-dim 1024 \
  --phase1-dropout "$DROPOUT" \
  --phase1-mil-topk "$TOPK" \
  --phase1-mil-tau "$TAU" \
  --phase1-mix-depth "$MIX_DEPTH" \
  --phase1-mix-heads "$MIX_HEADS" \
  --phase1-mix-mlp-ratio 2.0 \
  --phase1-mix-local-kernel-size "$MIX_LOCAL_KERNEL" \
  --phase1-proj-type "$PROJ_TYPE" \
  --phase1-use-per-concept-tau \
  --wandb \
  --wandb-project "cbm_stage2" \
  --wandb-run-name "stage2_concept_only_adaptivetau_${RUN_TAG}" \
  --early-stop-patience 10

echo "============================================================"
echo "STAGE 2 TRAINING COMPLETE!"
echo "============================================================"

