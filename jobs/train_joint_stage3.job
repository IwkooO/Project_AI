#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=joint_train_stage3
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=24:00:00
#SBATCH --output=jobs/outputs/joint_train_stage3_%j.out

set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"

# Activate environment
export GEOTIFF_CSV="${GEOTIFF_CSV:-}"
set +u
source activate streetview
set -u

wandb_api_key="9073a011764cb23fce5384443a3996ca9c5d9198"
export WANDB_API_KEY="$wandb_api_key"

# ============================================================
# JOINT TRAINING CONFIG (Stage 3)
# ============================================================
# Use hyperparameters from your best Phase 1 / Stage 2 runs
TAU=0.25
TOPK=6
MIX_LOCAL_KERNEL=5
CONCEPT_DIM=768
PROJ_TYPE=simple
DROPOUT=0.45
PHASE1_DROPOUT=0.45
STAGE2_DROPOUT=0.1

# Learning rates
LR=1e-4
PHASE1_LR=1e-5  # Use lower LR for Phase 1 refinement

# Mode: 'both' or 'concept_only'
# IMPORTANT: Mode must match the Stage 2 checkpoint mode, or loading will crash
# The checkpoint below is trained with "both" mode, so MODE must be "both"
MODE="both"

RUN_TAG="stage3_joint_${MODE}_tau${TAU}_k${TOPK}_cdim${CONCEPT_DIM}_nophase2"
OUTPUT_DIR="checkpoints/stage3_joint/${RUN_TAG}"

# Paths
SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
TRAIN_CSV="${SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${SPLITS_DIR}/dataset_val.csv"
TEST_CSV="${SPLITS_DIR}/dataset_test.csv"
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"

# Find Phase 1 run directory from base dir
PHASE1_BASE_DIR="checkpoints/phase1_textinit_adaptive/reg-cbm_stage_1_textinit_visinit_interpretable_tau0.25_k6_stk0.45_lk5_cdim768_adaptivetau"
PHASE1_RUN_DIR=$(find "$PHASE1_BASE_DIR" -type d -name "run_*" | sort -r | while read run_dir; do
  if [[ -d "$run_dir/concept_data_v2" ]] && [[ -f "$run_dir/concept_data_v2/concept_vocab.json" ]]; then
    echo "$run_dir"
    break
  fi
done | head -n 1)

if [[ -z "$PHASE1_RUN_DIR" ]]; then
  echo "ERROR: Could not find a valid Phase 1 run directory in $PHASE1_BASE_DIR"
  exit 1
fi

PHASE1_CONCEPT_DATA="${PHASE1_RUN_DIR}/concept_data_v2"
PHASE1_SPLITS_DIR="${PHASE1_RUN_DIR}/splits"

# Use the MAPPED splits from the Phase 1 run (they contain the 'generalized' column)
TRAIN_CSV="${PHASE1_SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${PHASE1_SPLITS_DIR}/dataset_val.csv"
TEST_CSV="${PHASE1_SPLITS_DIR}/dataset_test.csv"

# Pre-trained checkpoints to initialize from
PHASE1_CHECKPOINT="${PHASE1_BASE_DIR}/phase1/best_phase1.pt"

# Stage 2 checkpoint trained with "both" mode (better initialization for joint training)
STAGE2_BOTH_CHECKPOINT="checkpoints/stage2_textinit_heavy/stage2_adaptivetau_conc_only_tau0.25_k6_stk0.45_lk5_cdim768_adaptivetau_both/phase2/best_phase2.pt"


mkdir -p "$OUTPUT_DIR"

echo "============================================================"
echo "STAGE 3: JOINT TRAINING (Concepts + Geolocation)"
echo "============================================================"
echo "Mode: $MODE"
echo "Phase 1 LR: $PHASE1_LR"
echo "Stage 2 LR: $LR"
echo "Concept Data: $PHASE1_CONCEPT_DATA"
echo "Phase 1 Checkpoint: $PHASE1_CHECKPOINT"
echo "Stage 2 Checkpoint: $STAGE2_BOTH_CHECKPOINT"

python -m cbm.joint.train \
  --train-csv "$TRAIN_CSV" \
  --val-csv "$VAL_CSV" \
  --test-csv "$TEST_CSV" \
  --cached-dir "$CACHED_DIR" \
  --concept-data-dir "$PHASE1_CONCEPT_DATA" \
  --output-dir "$OUTPUT_DIR" \
  --phase1-checkpoint "$PHASE1_CHECKPOINT" \
  --mode "$MODE" \
  --num-cells 1000 \
  --hidden-dim 512 \
  --num-heads 8 \
  --num-layers 2 \
  --dropout "$STAGE2_DROPOUT" \
  --phase1-dropout "$PHASE1_DROPOUT" \
  --concept-dim "$CONCEPT_DIM" \
  --patch-dim 1024 \
  --mil-topk "$TOPK" \
  --mil-tau "$TAU" \
  --mix-depth 1 --mix-heads 4 --mix-mlp-ratio 2.0 \
  --mix-local-kernel-size "$MIX_LOCAL_KERNEL" \
  --proj-type "$PROJ_TYPE" \
  --use-per-concept-tau \
  --batch-size 64 \
  --num-workers 4 \
  --epochs 50 \
  --lr "$LR" \
  --phase1-lr "$PHASE1_LR" \
  --weight-decay 0.01 \
  --concept-loss-weight 1.0 \
  --cell-loss-weight 1.0 \
  --offset-loss-weight 10.0 \
  --wandb \
  --wandb-project "cbm_stage3_joint" \
  --wandb-run-name "$RUN_TAG" \
  --early-stop-patience 10

echo "============================================================"
echo "JOINT TRAINING COMPLETE!"
echo "============================================================"

