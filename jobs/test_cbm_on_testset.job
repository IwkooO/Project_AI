#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=test_cbm
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=2:00:00
#SBATCH --mem=16GB
#SBATCH --output=jobs/outputs/evaluation/test_cbm_%j.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/Project_AI/
source activate streetview

# Create output directories
mkdir -p jobs/outputs/evaluation
mkdir -p visualizations/test_predictions

# Paths
MODEL_PATH="checkpoints/cbm-finetuned/best_cbm_model.pth"
TEST_CSV="$HOME/Project_AI/data/691df1ee911f74393c53af8c/data_sa_beginner_test.csv"

echo "Testing CBM model on test set..."
echo "Model: $MODEL_PATH"
echo "Test CSV: $TEST_CSV"

python -u scripts/evaluation/test_cbm_on_testset.py \
    --model-path "$MODEL_PATH" \
    --test-csv "$TEST_CSV" \
    --output-dir "visualizations/test_predictions" \
    --num-samples 358 \
    --images-per-figure 4 \
    --top-k-concepts 5 \
    --batch-size 32 \
    --seed 42

echo "Testing finished."

