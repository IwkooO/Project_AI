#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=joint_train
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=12:00:00
#SBATCH --output=jobs/outputs/joint_train_%j.out

# Note: this env has activate.d scripts that reference optional env vars.
# Using `set -u` (nounset) can crash `source activate` on unset vars (e.g. GEOTIFF_CSV).
set -eo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/Project_AI/"

# Activate environment
export GEOTIFF_CSV="${GEOTIFF_CSV:-}"
set +u
source activate streetview
set -u

wandb_api_key="9073a011764cb23fce5384443a3996ca9c5d9198"
export WANDB_API_KEY="$wandb_api_key"

# Paths
SPLITS_DIR="data/6921d7831744c5356b098bf7_balanced/splits"
TRAIN_CSV="${SPLITS_DIR}/dataset_train.csv"
VAL_CSV="${SPLITS_DIR}/dataset_val.csv"
TEST_CSV="${SPLITS_DIR}/dataset_test.csv"

# Cached embeddings (must already exist)
CACHED_DIR="/scratch-shared/igodzwon/Project_AI/data/6921d7831744c5356b098bf7_balanced/cached_streetclip_v2"

# Concept vocab/priors
CONCEPT_DATA="data/concept_data_v2"

# Output directory for joint training
OUTPUT_DIR="checkpoints/JOINT_TRAINING"

# Stage2 mode: 'both', 'concept_only', or 'image_only'
STAGE2_MODE="both"

mkdir -p jobs/outputs
mkdir -p "$OUTPUT_DIR"

echo "============================================================"
echo "Joint Training: Phase 1 (Concept) + Phase 2 (Geolocation)"
echo "============================================================"
echo "Cached embeddings: $CACHED_DIR"
echo "Output directory: $OUTPUT_DIR"
echo "Mode: $STAGE2_MODE"
echo "============================================================"

# Verify cached embeddings exist
if [[ ! -f "$CACHED_DIR/train_pooled_embeddings.pt" || ! -f "$CACHED_DIR/train_metadata.json" ]]; then
  echo "ERROR: Missing cached embeddings in $CACHED_DIR"
  echo "Run precompute_streetclip_embeddings.py first."
  exit 1
fi

# Verify patch tokens exist if mode requires them
if [[ "$STAGE2_MODE" == "both" || "$STAGE2_MODE" == "image_only" ]]; then
  if [[ ! -f "$CACHED_DIR/train_patch_tokens.pt" ]]; then
    echo "ERROR: Mode '$STAGE2_MODE' requires patch tokens, but they are not found."
    echo "Please set STAGE2_MODE='concept_only' or ensure patch tokens are cached."
    exit 1
  fi
fi

# Verify test CSV exists (optional but recommended)
if [[ ! -f "$TEST_CSV" ]]; then
  echo "WARNING: Test CSV not found: $TEST_CSV"
  echo "Test set evaluation will be skipped."
  TEST_CSV=""
fi

# Optional: Load pre-trained checkpoints
# Uncomment and set paths to resume from checkpoints:
PHASE1_CHECKPOINT="/home/igodzwon/Project_AI/checkpoints/cbm_query_topk_256_neighborhood_k5_v2_higheracc/phase1/best_phase1.pt"
PHASE2_CHECKPOINT="/home/igodzwon/Project_AI/checkpoints/STAGE2_BOTH_GATE/phase2/best_phase2.pt"
# Or resume from a previous joint training run:
# RESUME_JOINT="checkpoints/JOINT_TRAINING"

echo "============================================================"
echo "Joint Training Configuration"
echo "  - Phase 1: Concept prediction (trainable)"
echo "  - Phase 2: Geolocation (trainable)"
echo "  - Mode: $STAGE2_MODE"
echo "  - Num cells: 1000"
echo "  - Hidden dim: 512"
echo "  - Cross-attention layers: 2"
echo "  - Concept loss weight: 1.0"
echo "  - Cell loss weight: 1.0"
echo "  - Offset loss weight: 6371.0"
echo "  - Phase 1 LR: 7e-5 (separate from Phase 2 LR: 1e-4)"
if [[ -n "$TEST_CSV" ]]; then
  echo "  - Test evaluation: Enabled"
else
  echo "  - Test evaluation: Disabled (no test CSV)"
fi
echo "============================================================"

python scripts/training/train_joint.py \
  --train-csv "$TRAIN_CSV" \
  --val-csv "$VAL_CSV" \
  ${TEST_CSV:+--test-csv "$TEST_CSV"} \
  --cached-dir "$CACHED_DIR" \
  --concept-data-dir "$CONCEPT_DATA" \
  --output-dir "$OUTPUT_DIR" \
  ${PHASE1_CHECKPOINT:+--phase1-checkpoint "$PHASE1_CHECKPOINT"} \
  ${PHASE2_CHECKPOINT:+--phase2-checkpoint "$PHASE2_CHECKPOINT"} \
  ${RESUME_JOINT:+--resume-joint-checkpoint "$RESUME_JOINT"} \
  --num-cells 1000 \
  --hidden-dim 512 \
  --num-heads 8 \
  --num-layers 2 \
  --dropout 0.1 \
  --phase1-dropout 0.3 \
  --mode "$STAGE2_MODE" \
  --batch-size 64 \
  --num-workers 2 \
  --epochs 100 \
  --lr 1e-4 \
  --phase1-lr 7e-5 \
  --weight-decay 0.01 \
  --concept-loss-weight 1.0 \
  --cell-loss-weight 1.0 \
  --offset-loss-weight 6371.0 \
  --concept-dim 256 \
  --patch-dim 1024 \
  --mil-topk 8 \
  --mil-tau 0.3 \
  --mix-depth 1 \
  --mix-heads 4 \
  --mix-mlp-ratio 2.0 \
  --mix-local-kernel-size 5 \
  --text-model-name "geolocal/StreetCLIP" \
  --concept-prompt-template "a street view photo containing {}" \
  --wandb \
  --wandb-project "cbm_joint" \
  --wandb-run-name "joint_$(date +%Y%m%d_%H%M%S)" \
  --early-stop-patience 10

echo "============================================================"
echo "Joint training complete!"
echo "Outputs:"
echo "  - Phase 1: $OUTPUT_DIR/phase1/"
echo "    - Checkpoints: $OUTPUT_DIR/phase1/best_phase1.pt"
echo "  - Phase 2: $OUTPUT_DIR/phase2/"
echo "    - Checkpoints: $OUTPUT_DIR/phase2/best_phase2.pt"
echo "    - Visualizations: $OUTPUT_DIR/phase2/visualizations/"
if [[ -n "$TEST_CSV" ]]; then
  echo "    - Test results: $OUTPUT_DIR/phase2/test_results.json"
fi
echo "============================================================"

